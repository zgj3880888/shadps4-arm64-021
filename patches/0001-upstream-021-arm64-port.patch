+    u32 uVar5 = uVar8 & 0x80061ff;
+    if (sdk > 0x174ffff) {
+        uVar5 = uVar8;
+    }
+    uVar8 = uVar5 & 0x80049ff;
+    if (sdk > 0x34fffff) {
+        uVar8 = uVar5;
+    }
+    uVar5 = uVar8 & 0x80029ff;
+    if (sdk > 0x3ffffff) {
+        uVar5 = uVar8;
+    }
