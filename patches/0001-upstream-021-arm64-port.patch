+s32 PS4_SYSV_ABI sceFontWritingSetMaskInvisible(OrbisFontWriting* fontWriting, s32 mask) {
+    LOG_INFO(Lib_Font, "called");
+    LOG_DEBUG(Lib_Font, "{}",
+              formatParams({
+                  Param("fontWriting", fontWriting),
+                  Param("mask", mask),
