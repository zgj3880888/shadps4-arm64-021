+static s32 FindRequest(s32 req_id, NpAuthRequest** request) {
+    if (req_id <= 0) {
+        LOG_ERROR(Lib_NpAuth, "called with invalid request id: {}", req_id);
+        return ORBIS_NP_AUTH_ERROR_INVALID_ARGUMENT;
+    }
+    const auto it = g_auth_requests.find(req_id);
