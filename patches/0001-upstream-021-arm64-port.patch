+Endpoint Endpoint::IPv4(const char* dotted, u16 port) {
+    Endpoint e;
+    auto* in = reinterpret_cast<sockaddr_in*>(&e.addr);
+    in->sin_family = AF_INET;
+    in->sin_port = htons(port);
+    inet_pton(AF_INET, dotted, &in->sin_addr);
+    return e;
+}
