-            renderSurface->sc_y1 = 0;
-            return;
-        }
-    } else {
-        y0_out = surface_h;
-        if (surface_h < static_cast<u32>(y0)) {
-            renderSurface->sc_y0 = y0_out;
-            renderSurface->sc_y1 = y1;
-            return;
-        }
-        y0_out = static_cast<u32>(y0);
-        if (surface_h < h_u) {
-            h_u = surface_h;
-        }
-    }
-
-    const u32 y1_candidate = h_u + static_cast<u32>(y0);
-    if (y1_candidate <= surface_h) {
