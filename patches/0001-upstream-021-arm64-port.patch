+        return wr;
+    }
+    *result = req.res.content_length_result;
+    *contentLength = req.res.content_length;
+    LOG_INFO(Lib_Http, "reqId={} result={:#x} contentLength={}", reqId, static_cast<u32>(*result),
+             *contentLength);
