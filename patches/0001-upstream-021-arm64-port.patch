-        const int row_start = key.row;
-        const int col_start = key.col;
-        const int row_end = std::min(grid_rows, static_cast<int>(key.row + key.row_span));
-        const int col_end = std::min(grid_cols, static_cast<int>(key.col + key.col_span));
