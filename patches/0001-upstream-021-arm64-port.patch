+void EmulatorSettingsImpl::ClearGameSpecificOverrides() {
+    ClearGroupOverrides(m_general);
+    ClearGroupOverrides(m_network);
+    ClearGroupOverrides(m_log);
+    ClearGroupOverrides(m_debug);
