-    return;
-#endif
-
-    info.has_fetch_shader = true;
-    info.fetch_shader_sgpr_base = code_sgpr_base;
-
-    const auto fetch_data = ParseFetchShader(info);
-    ASSERT(fetch_data.has_value());
