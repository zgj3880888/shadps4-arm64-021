+class UserContext {
+public:
+    UserContext(LibraryContext* parent, s32 user_ctx_id,
+                Libraries::UserService::OrbisUserServiceUserId user_id)
+        : parent_ctx(parent), id(user_ctx_id), user_id(user_id) {}
+
+    void Lock() {
+        parent_ctx->Lock();
+    }
+
+    void Unlock() {
+        parent_ctx->Unlock();
+    }
+
+    void AddUser() {
+        Lock();
+        user_count++;
+        Unlock();
+    }
+
+    void RemoveUser() {
+        Lock();
+        user_count--;
+        Unlock();
+    }
+
+    bool IsDeleted() {
+        return deleting;
+    }
+
+    void MarkForDeletion() {
+        deleting = true;
+    }
+
+    bool IsBusy() {
+        parent_ctx->Lock();
+        s32 users = user_count;
