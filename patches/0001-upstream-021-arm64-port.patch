+        return -1;
+    }
+    auto* file = m_files[old_fd];
+    if (!file) {
+        return -1;
+    }
+    if (target_fd < 0 || target_fd >= 1024) {
+        return -1;
+    }
+    if (old_fd == target_fd) {
+        return target_fd;
