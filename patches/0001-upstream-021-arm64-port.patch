+s32 PS4_SYSV_ABI sceKernelFtruncate(s32 fd, s64 length) {
+    s32 result = posix_ftruncate(fd, length);
+    if (result < 0) {
+        LOG_ERROR(Kernel_Fs, "error = {}", *__Error());
+        return ErrnoToSceKernelError(*__Error());
+    }
+    return result;
+}
