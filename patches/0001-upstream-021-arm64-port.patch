-    for (OrbisSysmoduleModuleInternal mod : g_modules_array) {
-        if (mod.id == id && (mod.flags & OrbisSysmoduleModuleInternalFlags::IsDebug) != 0) {
-            return true;
-        }
-    }
-    return false;
-}
