-    std::memcpy(&tag, npid->opt + 4, sizeof(tag));
-    switch (tag) {
-    case kTagPs3:
-        return OrbisNpPlatformType::PS3;
-    case kTagVita:
-        return OrbisNpPlatformType::Vita;
-    case kTagPs4:
