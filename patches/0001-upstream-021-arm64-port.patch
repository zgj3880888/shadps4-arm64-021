+    void DrawPreviewLine(const Sizes& s, void* mem_data_void, size_t mem_size,
+                         size_t base_display_addr) {
+        IM_UNUSED(base_display_addr);
+        ImU8* mem_data = (ImU8*)mem_data_void;
+        ImGuiStyle& style = ImGui::GetStyle();
