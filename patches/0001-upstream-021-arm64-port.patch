+        u32 first_free = 0xffffffffu;
+        for (u32 i = 0; i < font_max; i++) {
+            const auto* entry = &entries_base[i];
+            const u32 active = entry->active;
+            const u32 stored_id = entry->unique_id;
+            const u64 stored_addr = entry->font_address;
