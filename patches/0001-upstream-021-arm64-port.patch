+static IR::Use FindUniqueUser(IR::Inst* inst, auto&& pred) {
+    IR::Use picked{};
+    for (auto& use : inst->Uses()) {
+        if (pred(use.user)) {
+            ASSERT(!picked.user);
+            picked = use;
+        }
+    }
+    ASSERT(picked.user);
+    return picked;
+}
