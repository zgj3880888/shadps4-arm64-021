-    const auto is_selectable_cell = [&](int row, int col) {
-        if (row < 0 || row >= grid_rows || col < 0 || col >= grid_cols) {
-            return false;
-        }
-        const ImeKbKeySpec* key = occupied[static_cast<std::size_t>(idx(row, col))];
