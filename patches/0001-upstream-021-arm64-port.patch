+static_assert(offsetof(OrbisNpMatching2RoomMemberDataInternalUpdateA,
+                       chgRoomMemberBinAttrInternal) == 0x20);
+static_assert(offsetof(OrbisNpMatching2RoomMemberDataInternalUpdateA,
+                       chgRoomMemberBinAttrInternalNum) == 0x28);
