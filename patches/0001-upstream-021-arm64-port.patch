+s32 PS4_SYSV_ABI posix_gettimeofday(OrbisKernelTimeval* tp, OrbisKernelTimezone* tz) {
+#ifdef _WIN64
+    if (tp) {
+        FILETIME filetime;
+        GetSystemTimePreciseAsFileTime(&filetime);
+
+        constexpr u64 UNIX_TIME_START = 0x295E9648864000;
+        constexpr u64 TICKS_PER_SECOND = 1000000;
+
+        u64 ticks = filetime.dwHighDateTime;
+        ticks <<= 32;
+        ticks |= filetime.dwLowDateTime;
+        ticks /= 10;
+        ticks -= UNIX_TIME_START;
+
+        tp->tv_sec = ticks / TICKS_PER_SECOND;
+        tp->tv_usec = ticks % TICKS_PER_SECOND;
+    }
+    if (tz) {
+        static int tzflag = 0;
+        if (!tzflag) {
+            _tzset();
+            tzflag++;
+        }
+        time_t t = 0;
+        time(&t);
+        struct tm tm_val;
+        localtime_s(&tm_val, &t);
+        tz->tz_minuteswest = -static_cast<s32>(_timezone / 60);
+        tz->tz_dsttime = (tm_val.tm_isdst > 0) ? 60 : 0;
+    }
+    return 0;
+#else
+    timeval tv;
+    const auto ret = gettimeofday(&tv, nullptr);
+    if (tp) {
+        tp->tv_sec = tv.tv_sec;
+        tp->tv_usec = tv.tv_usec;
+    }
+    if (tz) {
+        time_t t = tv.tv_sec;
+        struct tm tm_val;
+        localtime_r(&t, &tm_val);
+        s32 is_dst = (tm_val.tm_isdst > 0) ? 1 : 0;
+        s32 dst_sec_val = is_dst ? 3600 : 0;
+        s32 standard_offset_sec = static_cast<s32>(tm_val.tm_gmtoff) - dst_sec_val;
+        tz->tz_minuteswest = standard_offset_sec / 60;
+        tz->tz_dsttime = dst_sec_val / 60;
+    }
+    if (ret < 0) {
+        SetPosixErrno(errno);
+        return -1;
+    }
+    return 0;
+#endif
+}
+
+s32 PS4_SYSV_ABI sceKernelGettimeofday(OrbisKernelTimeval* tp) {
+    if (const auto ret = posix_gettimeofday(tp, nullptr); ret < 0) {
+        return ErrnoToSceKernelError(*__Error());
+    }
+    return ORBIS_OK;
+}
