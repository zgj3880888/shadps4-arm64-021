+s32 PS4_SYSV_ABI posix_pthread_mutex_destroy(PthreadMutexT* mutex) {
+    PthreadMutexT m = *mutex;
+    if (m < THR_MUTEX_DESTROYED) {
+        return 0;
+    }
+    if (m == THR_MUTEX_DESTROYED) {
+        return POSIX_EINVAL;
+    }
+    if (m->m_owner.load(std::memory_order_acquire) != nullptr) {
+        return POSIX_EBUSY;
+    }
+    *mutex = THR_MUTEX_DESTROYED;
+    delete m;
+    return 0;
+}
