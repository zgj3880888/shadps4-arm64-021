+    u64 dfmt : 4;
+    u64 nfmt : 3;
+    u64 : 28;
+    u64 slc : 1;
+    u64 tfe : 1;
+    u64 count : 3;
+    u64 size : 5;
+};
+
+struct InstControlMIMG {
+    u64 : 8;
+    u64 dmask : 4;
+    u64 unrm : 1;
+    u64 glc : 1;
+    u64 da : 1;
+    u64 r128 : 1;
+    u64 tfe : 1;
+    u64 lwe : 1;
+    u64 : 7;
+    u64 slc : 1;
+    u64 mod : 32;
+    u64 : 6;
+};
+
+struct InstControlDS {
+    u64 offset0 : 8;
+    u64 offset1 : 8;
+    u64 : 1;
+    u64 gds : 1;
+    u64 dual : 1;
+    u64 sign : 1;
+    u64 relative : 1;
+    u64 stride : 1;
+    u64 size : 4;
+    u64 : 38;
+};
+
+struct InstControlVINTRP {
+    u32 : 8;
+    u32 chan : 2;
+    u32 attr : 6;
+    u32 : 16;
+};
+
+struct InstControlEXP {
+    u64 en : 4;
+    u64 target : 6;
+    u64 compr : 1;
+    u64 done : 1;
+    u64 vm : 1;
+    u64 reserved : 51;
+};
+
+union InstControl {
+    InstControlSOPK sopk;
+    InstControlSOPP sopp;
+    InstControlVOP3 vop3;
+    InstControlVOP3P vop3p;
+    InstControlSMRD smrd;
+    InstControlMUBUF mubuf;
+    InstControlMTBUF mtbuf;
+    InstControlMIMG mimg;
+    InstControlDS ds;
+    InstControlVINTRP vintrp;
+    InstControlEXP exp;
+};
