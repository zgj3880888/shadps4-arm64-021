+        : parent_ctx(parent), id(request_id), api_group(api_group), path(path), method(method),
+          multipart_supported(multipart), content_type(content_parameter->content_type),
+          content_length(content_parameter->content_length) {}
+
+    void Lock() {
+        parent_ctx->Lock();
+    }
+
+    void Unlock() {
+        parent_ctx->Unlock();
+    }
+
