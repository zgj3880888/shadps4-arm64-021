-// there isn't a strlcpy function in windows/glibc so implement one
-u64 strlcpy(char* dst, const char* src, u64 size) {
-    u64 src_len = strlen(src);
-
-    if (size > 0) {
-        u64 copy_len = (src_len >= size) ? (size - 1) : src_len;
-        memcpy(dst, src, copy_len);
-        dst[copy_len] = '\0';
-    }
-
-    return src_len;
-}
