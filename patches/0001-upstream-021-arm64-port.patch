+    if (((font_id == 10) && (static_cast<u32>(glyph_index - 0x23d1U) < 0x5e)) &&
+        ((0x5c0000000017ULL >>
+          (static_cast<u64>(static_cast<u8>((static_cast<u8>(glyph_index - 0x23d1U) >> 1) & 0x3f)) &
+           0x3fULL)) &
+         1ULL) != 0) {
+        inout_seed_words[0] = inout_seed_words[0] + 500;
+    }
+}
