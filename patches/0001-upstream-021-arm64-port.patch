-        } else {
-            auto cindex = GetCharacterIndex(pos);
-            u.mRemovedStart = u.mRemovedEnd = GetActualCursorCoordinates();
-            u.mRemovedEnd.mColumn++;
-            u.mRemoved = GetText(u.mRemovedStart, u.mRemovedEnd);
