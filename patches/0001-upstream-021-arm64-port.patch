+enum class ShadNetState {
+    Ok,
+    FailureInput,
+    FailureResolve,
+    FailureConnect,
+    FailureServerInfo,
+    FailureAuth,
+    FailureAlreadyIn,
+    FailureUsername,
+    FailurePassword,
+    FailureToken,
+    FailureProtocol,
+    FailureOther,
+};
