+            , libxkbcommon
+            , systemdMinimal
+            , libuuid
+            , libx11
+            , sdl3
+            , gtest
+              # System Libraries:
+            , boost
+            , cli11
+            , ffmpeg
+            , fmt
+            , freetype
+            , glslang
+            , half
+            , magic-enum
+            , miniupnpc
