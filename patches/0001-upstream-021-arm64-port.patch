+    RoomMissing = 14,
+    RoomAlreadyJoined = 15,
+    RoomFull = 16,
+    RoomPasswordMismatch = 17,
+    RoomPasswordMissing = 18,
+    RoomGroupNoJoinLabel = 19,
+    RoomGroupFull = 20,
