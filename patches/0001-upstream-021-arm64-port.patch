+    T after;
+};
+
+template <typename T>
+struct is_change_tracked : std::false_type {};
+
+template <typename T>
+struct is_change_tracked<ChangeTracked<T>> : std::true_type {
+    using value_type = T;
+};
+
+template <typename T>
+ChangeTracked<T> trackChange(T before, T after) {
+    return ChangeTracked<T>{before, after};
+}
