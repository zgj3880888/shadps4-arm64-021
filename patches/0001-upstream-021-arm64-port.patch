+static const BuiltinFontBlob* FindBuiltinFontBlob(const std::filesystem::path& path) {
+    const std::string normalized = path.generic_string();
+    for (const auto& blob : kBuiltinFontBlobs) {
+        if (normalized == blob.virtual_path) {
+            return &blob;
+        }
+    }
+    return nullptr;
+}
