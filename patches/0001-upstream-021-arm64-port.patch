+static void AddFlatbuf(Info& info) {
+    if (!info.has_flatbuf) {
+        info.buffers.push_back({
+            .used_types = IR::Type::U32,
+            .buffer_type = BufferType::Flatbuf,
+        });
+        info.has_flatbuf = true;
+    }
