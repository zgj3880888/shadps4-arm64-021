+void Translator::V_SUBREV_I32(const GcnInst& inst) {
+    // Unsigned components
+    const IR::U32 src0{GetSrc(inst.src[0])};
+    const IR::U32 src1{GetSrc(inst.src[1])};
+    const IR::U32 result{ir.ISub(src1, src0)};
+    SetDst(inst.dst[0], result);
