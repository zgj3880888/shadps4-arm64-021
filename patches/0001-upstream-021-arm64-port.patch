-#endif
-    switch (type) {
-    case ORBIS_NET_SOCK_STREAM:
-    case ORBIS_NET_SOCK_DGRAM:
-        if (family == ORBIS_NET_AF_UNIX) {
-            socket = std::make_shared<UnixSocket>(family, type, protocol);
