+        /*statusOut=*/nullptr, /*statusAOut=*/nullptr, static_cast<u64>(arrayLen), ctx,
+        /*statusCSOut=*/statusArray);
+    if (submit < 0) {
+        return submit;
+    }
+    return ORBIS_OK;
