+                           ORBIS_NET_SOCK_DGRAM, 0),
+              ORBIS_NET_ERROR_ENAMETOOLONG);
+
+    // errno is per thread.
+    std::thread([] { EXPECT_EQ(*sceNetErrnoLoc(), 0); }).join();
