+    EXPECT_EQ(ToP2PAddress(AsGuest(&guest), sizeof(guest), P2PKind::Stream, &endpoint, &port),
+              ORBIS_NET_EAFNOSUPPORT);
+    EXPECT_EQ(ToP2PAddress(nullptr, sizeof(guest), P2PKind::Stream, &endpoint, &port),
+              ORBIS_NET_EFAULT);
+}
