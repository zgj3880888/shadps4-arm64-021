+s32 FindTransportByOnlineIdLocked(std::string_view online_id) {
+    for (const auto& [transport_id, transport] :
+         NpHandler::GetInstance().GetSignalingState().peer_transports) {
+        if (TransportMatchesOnlineId(transport, online_id)) {
+            return transport_id;
+        }
