+void PS4_SYSV_ABI sceFontRenderSurfaceInit(OrbisFontRenderSurface* renderSurface, void* buffer,
+                                           int bufWidthByte, int pixelSizeByte, int widthPixel,
+                                           int heightPixel) {
+    LOG_INFO(Lib_Font, "called");
+
+    if (!renderSurface) {
+        LOG_ERROR(Lib_Font, "NULL_POINTER");
