-            s32 handle = linker->LoadAndStartModule(lle_path, argc, argv, &start_result);
-            if (handle >= 0) {
-                mod.handle = handle;
-                mod.is_loaded++;
-                if (res_out != nullptr) {
-                    *res_out = start_result;
-                }
