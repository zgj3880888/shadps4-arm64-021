+// Patch XML numeric values accept an explicit hex prefix (`0x`, `#`, `$`); everything else is
+// decimal. Parsing is strict so a malformed value is reported instead of silently truncated.
+bool ParseStrictNumber(const std::string& str, uint64_t& out_val) {
+    std::string_view sv = str;
+    int base = 10;
+    if (sv.size() >= 2 && (sv[0] == '#' || sv[0] == '$')) {
+        sv.remove_prefix(1);
+        base = 16;
+    } else if (sv.size() >= 3 && sv[0] == '0' && (sv[1] == 'x' || sv[1] == 'X')) {
+        sv.remove_prefix(2);
+        base = 16;
+    }
+    if (sv.empty() || sv.size() > 20) {
+        return false;
+    }
+    uint64_t val = 0;
+    for (const char c : sv) {
+        int digit = -1;
+        if (c >= '0' && c <= '9') {
+            digit = c - '0';
+        } else if (base == 16 && c >= 'a' && c <= 'f') {
+            digit = c - 'a' + 10;
+        } else if (base == 16 && c >= 'A' && c <= 'F') {
