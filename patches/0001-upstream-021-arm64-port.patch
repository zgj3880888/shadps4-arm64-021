+LibraryContext* getLibraryContext(s32 lib_ctx_id) {
+    std::scoped_lock lk{g_mutex};
+
+    if (!g_lib_contexts.contains(lib_ctx_id)) {
+        return nullptr;
+    }
+    LibraryContext* lib_ctx = g_lib_contexts.at(lib_ctx_id);
+    if (lib_ctx->IsDeleted()) {
+        return nullptr;
+    }
+    lib_ctx->AddUser();
+    return lib_ctx;
+}
