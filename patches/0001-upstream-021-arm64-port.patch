+int PS4_SYSV_ABI posix_pthread_cond_destroy(PthreadCondT* cond) {
+    PthreadCond* cvp = *cond;
+    if (cvp == THR_COND_INITIALIZER) {
+        return 0;
+    }
+    if (cvp == THR_COND_DESTROYED) {
+        return POSIX_EINVAL;
+    }
+    cvp = *cond;
+    *cond = THR_COND_DESTROYED;
+    delete cvp;
+    return 0;
+}
