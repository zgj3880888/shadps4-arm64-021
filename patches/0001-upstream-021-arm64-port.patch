-    }
-    case Core::FileSys::FileType::Epoll:
-    case Core::FileSys::FileType::Resolver:
-    case Core::FileSys::FileType::Equeue: {
-        LOG_ERROR(Kernel_Fs, "(STUBBED) file type {}", magic_enum::enum_name(file->type.load()));
