-    if (context == ORBIS_NP_TROPHY_INVALID_CONTEXT) {
-        return ORBIS_NP_TROPHY_ERROR_INVALID_CONTEXT;
-    }
-
-    Common::SlotId contextId;
-    contextId.index = context - 1;
-
-    if (contextId.index >= trophy_contexts.size()) {
