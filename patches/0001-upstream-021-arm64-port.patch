+static s32 PS4_SYSV_ABI sceMusicPlayerServiceSetTrackList2(s32 player_id, const void* tracks,
+                                                           u32 count, u32 flags) {
+    return SetTrackListInternal(player_id, tracks, count, flags, 0xc48);
+}
