-                 "BACHATA_AVPLAYER_TRACE stage=get_audio_data_success count={} frame_ts={} last_audio_ts={} eof={}",
-                 count, audio_info.timestamp, m_atomic_last_audio_ts.load(std::memory_order_relaxed),
