+    LOG_DEBUG(Lib_Font, "{}",
+              formatParams({
+                  Param("fontString", fontString),
+                  Param("characterCount", characterCount),
+              }));
+
+    auto* s = GetHleFontString(fontString);
+    if (!s || s->text_count == 0) {
+        if (characterCount) {
+            *characterCount = 0;
+        }
+        return nullptr;
+    }
+
+    if (characterCount) {
+        *characterCount = s->text_count;
+    }
+
+    return GetTextCharacters(s);
+}
