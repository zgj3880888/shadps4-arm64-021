-            file_mode = 3;
-            if ((~calc_mode & 3) == 0) {
-                break;
-            }
-        } else if (mode_str[1] != 'b') {
-            file_mode = 0x20;
-            if ((calc_mode & 0x20) != 0) {
-                break;
-            }
-        }
-        mode_str++;
-        calc_mode = file_mode | calc_mode;
-        file->_Mode = calc_mode;
-    } while (true);
