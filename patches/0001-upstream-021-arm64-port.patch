+        for (u32 i = 0; i < frames; i++) {
+            const u32 o = i << 3;
+            const float center = DOWNMIX_CENTER * s[o + FC];
+            d[i * 2 + 0] =
+                DOWNMIX_FRONT * s[o + FL] + center + DOWNMIX_SURROUND * (s[o + 4] + s[o + 6]);
+            d[i * 2 + 1] =
+                DOWNMIX_FRONT * s[o + FR] + center + DOWNMIX_SURROUND * (s[o + 5] + s[o + 7]);
