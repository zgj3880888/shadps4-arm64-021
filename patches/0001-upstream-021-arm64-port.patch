+    const OrbisNpWebApi2PushEventFilterParameter* filter_param, u64 filter_param_num) {
+    if ((np_service_name && np_service_label == ORBIS_NP_INVALID_SERVICE_LABEL) || !filter_param ||
+        filter_param_num == 0) {
