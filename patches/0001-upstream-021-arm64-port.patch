+        {ORBIS_NET_SOL_SOCKET, ORBIS_NET_SO_REUSEPORT, 1},
+        {ORBIS_NET_SOL_SOCKET, ORBIS_NET_SO_ONESBCAST, 1},
+        {ORBIS_NET_IPPROTO_IP, ORBIS_NET_IP_TTLCHK, 1},
