+constexpr u32 OrbisSaveDataBlockSize = 32768; // 32 KiB
+
+constexpr auto SAVE_ICON_SIZE = ImVec2{152.0f, 85.0f};
+constexpr auto SAVE_ICON_PADDING = ImVec2{8.0f, 2.0f};
