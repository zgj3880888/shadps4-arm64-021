+        LOG_ERROR(Lib_NpScore, "Too many accountIds requested: {}", arrayNum);
+        return ORBIS_NP_COMMUNITY_ERROR_TOO_MANY_NPID;
+    }
+    if (arrayNum == 0 || rankArray == nullptr || accountIdArray == nullptr) {
