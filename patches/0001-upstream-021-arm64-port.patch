+        lib_ctx->RemoveUser();
+        return ORBIS_NP_WEBAPI2_ERROR_USER_CONTEXT_NOT_FOUND;
+    }
+
+    s32 result = user_ctx->DeletePushContextCallback(callback_id);
+    user_ctx->RemoveUser();
+    lib_ctx->RemoveUser();
+    return result;
+}
