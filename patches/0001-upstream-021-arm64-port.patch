+s32 PS4_SYSV_ABI posix_pthread_mutex_unlock(PthreadMutexT* mutex) {
+    PthreadMutex* mp = *mutex;
+    if (mp <= THR_MUTEX_DESTROYED) [[unlikely]] {
+        if (mp == THR_MUTEX_DESTROYED) {
+            return POSIX_EINVAL;
+        }
+        return POSIX_EPERM;
+    }
+    return mp->Unlock();
