+class ShadNetClient {
+public:
+    ShadNetClient();
+    ~ShadNetClient();
+    ShadNetClient(const ShadNetClient&) = delete;
+    ShadNetClient& operator=(const ShadNetClient&) = delete;
+
+    void Start(const std::string& host, u16 port, const std::string& npid,
+               const std::string& password, const std::string& token = {});
+    void Stop();
+
+    ShadNetState WaitForConnection();
+    ShadNetState WaitForAuthenticated();
+
+    bool IsConnected() const;
+    bool IsAuthenticated() const;
+    ShadNetState GetState() const;
+
+    const std::string& GetAvatarUrl() const;
+    u64 GetUserId() const;
+    // Online ID this client logged in with (set once in Start()).
+    const std::string& GetNpid() const;
+    u32 GetServerProtocolVersion() const {
+        return m_server_protocol_version.load();
+    }
+    u32 GetAddrLocal() const;
+    u32 GetAddrServer() const;
+    bool IsMatching2Enabled() const;
+    // True on the thread that reads replies. Code running there must not wait for a reply.
+    static bool OnReaderThread();
+    bool IsTrophiesEnabled() const;
+    u64 ReportClientVersion();
+    static std::string BuildVersionString();
+
+    u64 UnlockTrophy(const std::string& com_id, s32 trophy_id, u64 timestamp);
+    u64 SyncTrophies(const std::string& com_id,
+                     const std::vector<std::pair<s32, u64>>& local_trophies);
+    u32 GetNumFriends() const;
+    std::optional<std::string> GetFriendNpid(u32 index) const;
+
+    std::string GetBearerToken() const;
+
+    // Callbacks
+    std::function<void(const LoginResult&)> onLoginResult;
+    std::function<void(const NotifyFriendQuery&)> onFriendQuery;
+    std::function<void(const NotifyFriendNew&)> onFriendNew;
+    std::function<void(const NotifyFriendLost&)> onFriendLost;
+    std::function<void(const NotifyFriendStatus&)> onFriendStatus;
+    std::function<void(const NotifyRoomEvent&)> onRoomEvent;
+    std::function<void(const NotifyRoomMessage&)> onRoomMessage;
+    std::function<void(const NotifyWebApiPushEvent&)> onWebApiPushEvent;
+    std::function<void(const NotifyServiceUnavailable&)> onServiceUnavailable;
+    std::function<void(const NotifyClientRejected&)> onClientRejected;
+    // Async reply callback.
+    //   cmd    —command this reply is for (matches the request's cmd)
+    //   pkt_id —packet id echoed back from the original request header
+    //   error  —ErrorType byte that prefixes every reply body
+    //   body   —reply payload AFTER the error byte (may be empty)
+    std::function<void(CommandType cmd, u64 pkt_id, ErrorType error, const std::vector<u8>& body)>
+        onAsyncReply;
+
+    // Submit a Request packet for async processing.
+    // Allocates a packet id, builds the packet, pushes it to the writer queue.
+    // Returns the packet id so callers can correlate the eventual reply.
+    u64 SubmitRequest(CommandType cmd, const std::vector<u8>& payload);
+
+    // Friend / block commands.
+    u64 AddFriend(const std::string& npid);
+    u64 RemoveFriend(const std::string& npid);
+    u64 AddBlock(const std::string& npid);
+    u64 RemoveBlock(const std::string& npid);
+    // Set the Appear-Offline preference mid-session (server handles us as offline while set).
+    u64 SetAppearOffline(bool enable);
+    // Global online ID to account ID resolution
+    u64 LookupOnlineId(const std::string& npid);
+    // Single-use authorization code for a game's backend (sceNpAuthGetAuthorizationCode)
+    u64 GetAuthorizationCode(const std::string& client_id, const std::string& scope);
+
+private:
+    void ConnectThread();
+    void ReaderThread();
+    void WriterThread();
+    bool DoConnect();
+    void DoDisconnect();
+    bool RecvN(u8* buf, u32 n);
+    bool SendAll(const std::vector<u8>& data);
+    std::vector<u8> BuildPacket(CommandType cmd, u64 id, const std::vector<u8>& payload) const;
+    void DispatchPacket(PacketType type, u16 cmd_raw, u64 pkt_id, const std::vector<u8>& payload);
+    void HandleLoginReply(const std::vector<u8>& payload);
+    void HandleGetTokenReply(const std::vector<u8>& payload);
+    void HandleServerFeaturesReply(const std::vector<u8>& payload);
+    void HandleNotification(u16 cmd_raw, const std::vector<u8>& payload);
+    bool RequestServerFeatures();
+
+    // Helper: read a u32-LE-prefixed proto blob from a byte vector at pos.
+    static std::string ExtractBlob(const std::vector<u8>& p, int pos);
+
+    static void PutLE16(std::vector<u8>& b, size_t off, u16 v);
+    static void PutLE32(std::vector<u8>& b, size_t off, u32 v);
+    static void PutLE64(std::vector<u8>& b, size_t off, u64 v);
+    static u16 GetLE16(const u8* p);
+    static u32 GetLE32(const u8* p);
+    static u64 GetLE64(const u8* p);
+
+    ShadSocketHandle m_sock = SHAD_INVALID_SOCK;
+    std::string m_host;
+    u16 m_port = 31313;
+    std::string m_npid;
+    std::string m_password;
+    std::string m_token;
+    bool m_appear_offline = false; // user's Appear-Offline preference (sent at login)
+
+    std::atomic<bool> m_terminate{false};
+    std::atomic<bool> m_connected{false};
+    std::atomic<bool> m_authenticated{false};
+    std::atomic<ShadNetState> m_state{ShadNetState::Ok};
+
+    std::binary_semaphore m_sem_connected{0};
+    std::binary_semaphore m_sem_authenticated{0};
+    std::mutex m_mutex_connected;
+    std::mutex m_mutex_authenticated;
+
+    std::thread m_thread_connect;
+    std::thread m_thread_reader;
+    std::thread m_thread_writer;
+
+    std::mutex m_mutex_send_direct;
+    std::mutex m_mutex_send_queue;
+    std::condition_variable m_cv_send_queue;
+    std::vector<std::vector<u8>> m_send_queue;
+
+    std::string m_avatar_url;
+    u64 m_user_id = 0;
+    mutable std::mutex m_mutex_bearer;
+    std::string m_bearer_token;
+    std::atomic<u32> m_addr_local{0};
+    std::atomic<u32> m_addr_server{0};
+    std::atomic<u32> m_server_protocol_version{0};
+    std::atomic<bool> m_matching2_enabled{false};
+    std::atomic<bool> m_trophies_enabled{false};
+    std::atomic<bool> m_server_features_received{false};
+
+    mutable std::mutex m_mutex_friends;
+    std::vector<FriendEntry> m_friends;
+
+    std::atomic<u64> m_pkt_counter{1};
+};
+
+} // namespace ShadNet
diff --git a/src/shadnet/server_probe.cpp b/src/shadnet/server_probe.cpp
new file mode 100644
index 00000000..f616b479
--- /dev/null
+++ b/src/shadnet/server_probe.cpp
@@ -0,0 +1,185 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <string>
+#include <vector>
+#include "common/logging/log.h"
+#include "shadnet/client.h" // socket platform typedefs + protocol constants
+#include "shadnet/server_probe.h"
+
+#ifdef _WIN32
+#pragma comment(lib, "Ws2_32.lib")
+static void ProbePlatformInit() {
+    static bool done = false;
+    if (!done) {
+        WSADATA wd;
+        WSAStartup(MAKEWORD(2, 2), &wd);
+        done = true;
+    }
+}
+#else
+static void ProbePlatformInit() {}
+#endif
+
+namespace ShadNet {
+
+static u32 ProbeGetLE32(const u8* p) {
+    return static_cast<u32>(p[0]) | (static_cast<u32>(p[1]) << 8) | (static_cast<u32>(p[2]) << 16) |
+           (static_cast<u32>(p[3]) << 24);
+}
+
+// recv() exactly n bytes (blocking, bounded by the socket's SO_RCVTIMEO).
+static bool ProbeRecvN(ShadSocketHandle sock, u8* buf, u32 n) {
+    u32 got = 0;
+    while (got < n) {
+        const int r =
+            ::recv(sock, reinterpret_cast<char*>(buf) + got, static_cast<int>(n - got), 0);
+        if (r <= 0)
+            return false;
+        got += static_cast<u32>(r);
+    }
+    return true;
+}
+
+ProbeInfo ProbeServer(const std::string& host, u16 port, u32 timeout_ms) {
+    ProbeInfo info{};
+
+    if (host.empty()) {
+        LOG_WARNING(ShadNet, "probe skipped: empty shadNet host");
+        return info; // Unreachable
+    }
+
+    ProbePlatformInit();
+
+    struct addrinfo hints{}, *res_list = nullptr;
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+
+    if (::getaddrinfo(host.c_str(), std::to_string(port).c_str(), &hints, &res_list) != 0 ||
+        !res_list) {
+        LOG_WARNING(ShadNet, "probe: DNS resolution failed for '{}'", host);
+        return info; // Unreachable
+    }
+
+    ShadSocketHandle sock = ::socket(res_list->ai_family, SOCK_STREAM, IPPROTO_TCP);
+    if (sock == SHAD_INVALID_SOCK) {
+        ::freeaddrinfo(res_list);
+        return info; // Unreachable
+    }
+
+#ifdef _WIN32
+    {
+        u_long nb = 1;
+        ::ioctlsocket(sock, FIONBIO, &nb);
+    }
+#else
+    {
+        int fl = ::fcntl(sock, F_GETFL, 0);
+        ::fcntl(sock, F_SETFL, fl | O_NONBLOCK);
+    }
+#endif
+
+    const int cr = ::connect(sock, res_list->ai_addr, static_cast<int>(res_list->ai_addrlen));
+    ::freeaddrinfo(res_list);
+
+    bool connected = false;
+#ifdef _WIN32
+    const bool in_progress = (cr < 0 && WSAGetLastError() == WSAEWOULDBLOCK);
+#else
+    const bool in_progress = (cr < 0 && errno == EINPROGRESS);
+#endif
+    if (cr == 0 || in_progress) {
+        fd_set wfds;
+        FD_ZERO(&wfds);
+        FD_SET(sock, &wfds);
+        struct timeval tv{};
+        tv.tv_sec = static_cast<decltype(tv.tv_sec)>(timeout_ms / 1000);
+        tv.tv_usec = static_cast<decltype(tv.tv_usec)>((timeout_ms % 1000) * 1000);
+        if (::select(static_cast<int>(sock) + 1, nullptr, &wfds, nullptr, &tv) > 0) {
+            int err = 0;
+            socklen_t len = sizeof(err);
+            ::getsockopt(sock, SOL_SOCKET, SO_ERROR, reinterpret_cast<char*>(&err), &len);
+            connected = (err == 0);
+        }
+    }
+
+    if (!connected) {
+        SHAD_CLOSE(sock);
+        LOG_WARNING(ShadNet, "probe: server {}:{} is unreachable (timeout {} ms)", host, port,
+                    timeout_ms);
+        return info; // Unreachable
+    }
+
+    // Restore blocking mode and apply a receive timeout for the ServerInfo read.
+#ifdef _WIN32
+    {
+        u_long nb = 0;
+        ::ioctlsocket(sock, FIONBIO, &nb);
+    }
+    DWORD so_rcv = static_cast<DWORD>(timeout_ms);
+#else
+    {
+        int fl = ::fcntl(sock, F_GETFL, 0);
+        ::fcntl(sock, F_SETFL, fl & ~O_NONBLOCK);
+    }
+    struct timeval so_rcv{};
+    so_rcv.tv_sec = static_cast<decltype(so_rcv.tv_sec)>(timeout_ms / 1000);
+    so_rcv.tv_usec = static_cast<decltype(so_rcv.tv_usec)>((timeout_ms % 1000) * 1000);
+#endif
+    ::setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, reinterpret_cast<const char*>(&so_rcv),
+                 sizeof(so_rcv));
+
+    info.result = ProbeResult::ProtocolError;
+
+    u8 hdr[SHAD_HEADER_SIZE];
+    if (!ProbeRecvN(sock, hdr, SHAD_HEADER_SIZE)) {
+        SHAD_CLOSE(sock);
+        LOG_WARNING(ShadNet, "probe: {}:{} reachable but no ServerInfo header received", host,
+                    port);
+        return info;
+    }
+    if (static_cast<PacketType>(hdr[0]) != PacketType::ServerInfo) {
+        SHAD_CLOSE(sock);
+        LOG_WARNING(ShadNet, "probe: {}:{} sent packet type {:02x} instead of ServerInfo", host,
+                    port, hdr[0]);
+        return info;
+    }
+
+    const u32 total_sz = ProbeGetLE32(hdr + 3);
+    if (total_sz < SHAD_HEADER_SIZE || total_sz > SHAD_MAX_PACKET_SIZE) {
+        SHAD_CLOSE(sock);
+        LOG_WARNING(ShadNet, "probe: {}:{} sent corrupt ServerInfo (total_sz={})", host, port,
+                    total_sz);
+        return info;
+    }
+    const u32 payload_sz = total_sz - SHAD_HEADER_SIZE;
+    std::vector<u8> payload(payload_sz);
+    if (payload_sz > 0 && !ProbeRecvN(sock, payload.data(), payload_sz)) {
+        SHAD_CLOSE(sock);
+        LOG_WARNING(ShadNet, "probe: {}:{} ServerInfo payload read failed", host, port);
+        return info;
+    }
+    SHAD_CLOSE(sock);
+
+    if (payload_sz < 4) {
+        info.result = ProbeResult::Ok;
+        LOG_INFO(ShadNet, "probe: server {}:{} is reachable (no version field in ServerInfo)", host,
+                 port);
+        return info;
+    }
+
+    info.server_version = ProbeGetLE32(payload.data());
+    if (info.server_version != SHAD_PROTOCOL_VERSION) {
+        info.result = ProbeResult::VersionMismatch;
+        LOG_WARNING(ShadNet, "probe: server {}:{} protocol version mismatch (server v{}, ours v{})",
+                    host, port, info.server_version, SHAD_PROTOCOL_VERSION);
+        return info;
+    }
+
+    info.result = ProbeResult::Ok;
+    LOG_INFO(ShadNet, "probe: server {}:{} is reachable (protocol v{})", host, port,
+             info.server_version);
+    return info;
+}
+
+} // namespace ShadNet
diff --git a/src/shadnet/server_probe.h b/src/shadnet/server_probe.h
new file mode 100644
index 00000000..20355354
--- /dev/null
+++ b/src/shadnet/server_probe.h
@@ -0,0 +1,30 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <string>
+#include "common/types.h"
+
+namespace ShadNet {
+
+// Default timeout for the startup reachability probe.
+static constexpr u32 SHAD_PROBE_TIMEOUT_MS = 3000;
+
+enum class ProbeResult {
+    Ok,              // reachable and protocol version matches SHAD_PROTOCOL_VERSION
+    Unreachable,     // DNS failure, connect failure, or timeout
+    VersionMismatch, // reachable, but ServerInfo protocol version differs from ours
+    ProtocolError,   // reachable, but the ServerInfo handshake was malformed/absent
+};
+
+struct ProbeInfo {
+    ProbeResult result = ProbeResult::Unreachable;
+    // Protocol version reported by the server's ServerInfo packet.
+    // 0 when unknown (unreachable / malformed / server sent no version field).
+    u32 server_version = 0;
+};
+
+ProbeInfo ProbeServer(const std::string& host, u16 port, u32 timeout_ms = SHAD_PROBE_TIMEOUT_MS);
+
+} // namespace ShadNet
diff --git a/src/shadnet/shadnet.proto b/src/shadnet/shadnet.proto
new file mode 100644
index 00000000..fcf3abfb
--- /dev/null
+++ b/src/shadnet/shadnet.proto
@@ -0,0 +1,827 @@
+// SPDX-FileCopyrightText: Copyright 2019-2026 rpcsn Project
+// SPDX-FileCopyrightText: Copyright 2026 shadNet Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+syntax = "proto3";
+
+package shadnet;
+
+option optimize_for = LITE_RUNTIME;
+
+enum MatchingUserIdKind {
+    MATCHING_USER_ID_ONLINE_ID  = 0;
+    MATCHING_USER_ID_ACCOUNT_ID = 1;
+}
+
+// Account
+
+message LoginRequest {
+    string npid        = 1;
+    string password    = 2;
+    string token       = 3;
+    string title_id    = 4;  // running title serial (param.sfo TITLE_ID), for presence gameTitleInfo
+    string title_name  = 5;  // running title name (param.sfo TITLE)
+    bool appear_offline = 6; // user's Appear-Offline preference (handled as offline by others)
+}
+
+// Mid-session Appear-Offline toggle.
+message SetAppearOfflineRequest {
+    bool appear_offline = 1;
+}
+
+message ServerFeaturesReply {
+    bool matching2_enabled = 1;
+    bool trophies_enabled = 2;
+}
+
+message FriendEntry {
+    string npid     = 1;
+    bool   online   = 2;
+    bytes  presence = 3;
+}
+
+message LoginReply {
+    string               avatar_url               = 1;
+    uint64               user_id                  = 2;
+    repeated FriendEntry friends                  = 3;
+    repeated string      friend_requests_sent     = 4;
+    repeated string      friend_requests_received = 5;
+    repeated string      blocked                  = 6;
+}
+
+message RegistrationRequest {
+    string npid       = 1;
+    string password   = 2;
+    string avatar_url = 3;  // optional; server uses default if empty
+    string email      = 4;
+    string secret_key = 5;  // optional; must match server config if set
+}
+
+// Friend / block commands
+// Shared by AddFriend, RemoveFriend, AddBlock, RemoveBlock.
+
+message FriendCommandRequest {
+    string npid = 1;  // target Online ID
+}
+
+// Notifications
+
+// NotificationType::FriendQuery (5)
+message NotifyFriendQuery {
+    string from_npid = 1;
+}
+
+// NotificationType::FriendNew (6)
+message NotifyFriendNew {
+    string npid   = 1;
+    bool   online = 2;
+}
+
+// NotificationType::FriendLost (7)
+message NotifyFriendLost {
+    string npid = 1;
+}
+
+// NotificationType::FriendStatus (8)
+message NotifyFriendStatus {
+    string npid      = 1;
+    bool   online    = 2;
+    uint64 timestamp = 3;  // nanoseconds since Unix epoch
+}
+
+// Notification 18: the server refused a service to this player.
+//   service: 1 = Matching2 (matchmaking)
+//   reason:  1 = server full (in_use / limit are set), 2 = account not allowed,
+//            3 = service disabled on this server
+message NotifyServiceUnavailable {
+    uint32 service = 1;
+    uint32 reason  = 2;
+    uint32 in_use  = 3;
+    uint32 limit   = 4;
+}
+
+// Notification 19: the server is signing this client out, then disconnects.
+//   reason:  1 = client version not accepted (clientversions.cfg)
+//   message: text for the player, from the rule that matched
+//   version: the version the server checked ("" = none reported)
+message NotifyClientRejected {
+    uint32 reason  = 1;
+    string message = 2;
+    string version = 3;
+}
+
+// Score: board configuration
+
+message BoardInfo {
+    uint32 rankLimit       = 1;
+    uint32 updateMode      = 2;   // 0=NORMAL_UPDATE, 1=FORCE_UPDATE
+    uint32 sortMode        = 3;   // 0=DESCENDING, 1=ASCENDING
+    uint32 uploadNumLimit  = 4;
+    uint64 uploadSizeLimit = 5;
+}
+
+// Score: requests
+
+message RecordScoreRequest {
+    uint32 boardId  = 1;
+    int32  pcId     = 2;
+    int64  score    = 3;
+    string comment  = 4;
+    bytes  data     = 5;   // optional inline game-info blob
+    uint64 compareDate = 6;
+}
+
+message RecordScoreGameDataRequest {
+    uint32 boardId = 1;
+    int32  pcId    = 2;
+    int64  score   = 3;
+}
+
+message GetScoreGameDataRequest {
+    uint32 boardId = 1;
+    string npId    = 2;
+    int32  pcId    = 3;
+}
+
+message GetScoreRangeRequest {
+    uint32 boardId      = 1;
+    uint32 startRank    = 2;
+    uint32 numRanks     = 3;
+    bool   withComment  = 4;
+    bool   withGameInfo = 5;
+}
+
+message ScoreNpIdPcId {
+    string npid = 1;
+    int32  pcId = 2;
+}
+
+message GetScoreNpIdRequest {
+    uint32                  boardId      = 1;
+    repeated ScoreNpIdPcId  npids        = 2;
+    bool                    withComment  = 3;
+    bool                    withGameInfo = 4;
+}
+
+message GetScoreFriendsRequest {
+    uint32 boardId      = 1;
+    bool   includeSelf  = 2;
+    uint32 max          = 3;
+    bool   withComment  = 4;
+    bool   withGameInfo = 5;
+    uint32 startRank    = 6;
+}
+
+message ScoreAccountIdPcId {
+    int64 accountId = 1;
+    int32 pcId      = 2;
+}
+
+message GetScoreAccountIdRequest {
+    uint32                       boardId      = 1;
+    repeated ScoreAccountIdPcId  ids          = 2;
+    bool                         withComment  = 3;
+    bool                         withGameInfo = 4;
+}
+
+message GetScoreGameDataByAccountIdRequest {
+    uint32 boardId   = 1;
+    int64  accountId = 2;
+    int32  pcId      = 3;
+}
+
+// Score: responses
+
+message ScoreRankData {
+    string npId        = 1;
+    int32  pcId        = 2;
+    uint32 rank        = 3;
+    int64  score       = 4;
+    bool   hasGameData = 5;
+    uint64 recordDate  = 6;
+    int64  accountId   = 7;
+    uint32 sharedRank  = 8;
+}
+
+message ScoreInfo {
+    bytes data = 1;
+}
+
+message GetScoreResponse {
+    repeated ScoreRankData rankArray    = 1;
+    repeated string        commentArray = 2;
+    repeated ScoreInfo     infoArray    = 3;
+    uint64                 lastSortDate = 4;
+    uint32                 totalRecord  = 5;
+}
+
+// ── Matching ──────────────────────────────────────────────────────────────────
+
+// Shared attribute types
+
+message MatchingBinAttr {
+    uint32 attr_id          = 1;
+    bytes  data             = 2;
+    uint64 update_date      = 3;
+    uint32 update_member_id = 4;
+}
+
+message MatchingIntAttr {
+    uint32 attr_id    = 1;
+    uint32 attr_value = 2;
+}
+
+message MatchingRoomGroup {
+    uint32 group_id    = 1;
+    bool   has_passwd  = 2;
+    bool   has_label   = 3;
+    bytes  label       = 4;
+    uint32 slot_count  = 5;
+    uint32 num_members = 6;
+}
+
+message MatchingRoomGroupConfig {
+    uint32 slot_count = 1;
+    bool   has_label  = 2;
+    bytes  label      = 3;
+    bool   has_passwd = 4;
+}
+
+// Room data structures
+
+message MatchingRoomDataInternal {
+    uint32                   public_slots       = 1;
+    uint32                   private_slots      = 2;
+    uint32                   open_public_slots  = 3;
+    uint32                   open_private_slots = 4;
+    uint32                   max_slot           = 5;
+    uint32                   server_id          = 6;
+    uint32                   world_id           = 7;
+    uint32                   lobby_id           = 8;
+    uint64                   room_id            = 9;
+    uint64                   passwd_slot_mask   = 10;
+    uint32                   joined_slot_mask   = 11;
+    repeated MatchingRoomGroup groups           = 12;
+    uint32                   flags              = 13;
+    repeated MatchingBinAttr bin_attrs_internal = 14;
+}
+
+message MatchingRoomMemberData {
+    string                   npid               = 1;
+    uint32                   member_id          = 2;
+    uint32                   team_id            = 3;
+    bool                     is_owner           = 4;
+    MatchingRoomGroup        group              = 5;
+    repeated MatchingBinAttr bin_attrs_internal = 6;
+    uint64                   join_date          = 7;
+    uint32                   nat_type           = 8;
+    uint32                   flag_attr          = 9;
+    string                   addr               = 10;
+    uint32                   port               = 11;
+    uint32                   group_id           = 12;
+    uint64                   account_id         = 13;
+    uint32                   platform           = 14;
+}
+
+message MatchingRoomMemberDataExternal {
+    string npid       = 1;
+    uint32 member_id  = 2;
+    uint64 account_id = 3;
+    uint32 platform   = 4;
+    uint64 join_date  = 5;
+    uint32 role       = 6;
+}
+
+message MatchingRoomDataExternal {
+    uint32                   max_slot                    = 1;
+    uint32                   cur_members                 = 2;
+    uint32                   flags                       = 3;
+    uint32                   server_id                   = 4;
+    uint32                   world_id                    = 5;
+    uint64                   lobby_id                    = 6;
+    uint64                   room_id                     = 7;
+    uint64                   passwd_slot_mask            = 8;
+    uint64                   joined_slot_mask            = 9;
+    uint32                   public_slots                = 10;
+    uint32                   private_slots               = 11;
+    uint32                   open_public_slots           = 12;
+    uint32                   open_private_slots          = 13;
+    repeated MatchingRoomGroup   groups                  = 14;
+    repeated MatchingIntAttr     external_search_int_attrs = 15;
+    repeated MatchingBinAttr     external_search_bin_attrs = 16;
+    repeated MatchingBinAttr     external_bin_attrs        = 17;
+    string                       owner_npid               = 18;
+    uint64                       owner_account_id         = 19;
+    uint32                       owner_platform           = 20;
+}
+
+message CreateJoinRoomResponse {
+    MatchingRoomDataInternal        room_data       = 1;
+    repeated MatchingRoomMemberData members         = 2;
+    uint32                          me_member_id    = 3;
+    uint32                          owner_member_id = 4;
+}
+
+// Command requests
+
+message ContextStartRequest {
+    uint32 ctx_id = 1;
+}
+
+message ContextStopRequest {
+    uint32 ctx_id = 1;
+}
+
+message CreateRoomRequest {
+    uint32 req_id                  = 1;
+    uint32 max_slots               = 2;
+    uint32 team_id                 = 3;
+    uint32 world_id                = 4;
+    uint32 lobby_id                = 5;
+    uint32 flags                   = 6;
+    uint32 group_config_count      = 7;
+    uint32 allowed_user_count      = 8;
+    uint32 blocked_user_count      = 9;
+    uint32 internal_bin_attr_count = 10;
+    repeated MatchingIntAttr external_search_int_attrs = 11;
+    repeated MatchingBinAttr external_search_bin_attrs = 12;
+    repeated MatchingBinAttr external_bin_attrs        = 13;
+    repeated MatchingBinAttr member_bin_attrs          = 14;
+    bool   join_group_label_present = 15;
+    bool   room_password_present    = 16;
+    uint32 sig_type                 = 17;
+    uint32 sig_flag                 = 18;
+    uint32 sig_main_member          = 19;
+    repeated MatchingBinAttr internal_bin_attrs = 20;
+    MatchingUserIdKind user_id_kind = 21;
+    repeated string allowed_online_ids = 22;
+    repeated string blocked_online_ids = 23;
+    repeated uint64 allowed_account_ids = 24;
+    repeated uint64 blocked_account_ids = 25;
+    repeated MatchingRoomGroupConfig group_configs = 26;
+    bytes room_password = 27;
+    bool has_passwd_slot_mask = 28;
+    uint64 passwd_slot_mask = 29;
+    bytes join_group_label = 30;
+}
+
+message JoinRoomRequest {
+    uint64 room_id              = 1;
+    uint32 req_id               = 2;
+    uint32 team_id              = 3;
+    uint32 join_flags           = 4;
+    uint32 blocked_user_count   = 5;
+    repeated MatchingBinAttr member_bin_attrs   = 6;
+    bool   room_password_present    = 7;
+    bool   join_group_label_present = 8;
+    MatchingUserIdKind user_id_kind = 9;
+    repeated string blocked_online_ids = 10;
+    repeated uint64 blocked_account_ids = 11;
+}
+
+message LeaveRoomRequest {
+    uint64 room_id = 1;
+    uint32 req_id  = 2;
+}
+
+message RequestSignalingInfosRequest {
+    string target_npid = 1;
+}
+
+message SetRoomDataInternalRequest {
+    uint32 req_id           = 1;
+    uint64 room_id          = 2;
+    uint32 flag_filter      = 3;
+    uint32 flag_attr        = 4;
+    repeated MatchingBinAttr bin_attrs = 5;
+    bool   has_passwd_mask  = 6;
+    uint64 passwd_slot_mask = 7;
+}
+
+message SetRoomMemberDataInternalRequest {
+    uint32 req_id      = 1;
+    uint64 room_id     = 2;
+    uint32 member_id   = 3;
+    uint32 team_id     = 4;
+    uint32 flag_filter = 5;
+    uint32 flag_attr   = 6;
+    repeated MatchingBinAttr bin_attrs = 7;
+}
+
+message SetRoomDataExternalRequest {
+    uint32 req_id  = 1;
+    uint64 room_id = 2;
+    repeated MatchingIntAttr search_int_attrs = 3;
+    repeated MatchingBinAttr search_bin_attrs = 4;
+    repeated MatchingBinAttr ext_bin_attrs    = 5;
+}
+
+message KickoutRoomMemberRequest {
+    uint64 room_id          = 1;
+    uint32 req_id           = 2;
+    uint32 target_member_id = 3;
+    uint32 block_kick_flag  = 4;
+}
+
+// Command replies
+
+message CreateRoomReply {
+    uint64 room_id    = 1;
+    uint32 server_id  = 2;
+    uint32 world_id   = 3;
+    uint32 lobby_id   = 4;
+    uint32 member_id  = 5;
+    uint32 max_slots  = 6;
+    uint32 flags      = 7;
+    uint32 cur_members = 8;
+    CreateJoinRoomResponse details = 9;
+}
+
+message JoinRoomReply {
+    uint64 room_id    = 1;
+    uint32 member_id  = 2;
+    uint32 max_slots  = 3;
+    uint32 flags      = 4;
+    uint32 cur_members = 5;
+    CreateJoinRoomResponse details = 6;
+}
+
+message MatchingIntSearchFilter {
+    uint32 op       = 1;  // 1=Eq 2=Ne 3=Lt 4=Le 5=Gt 6=Ge
+    uint32 attr_id  = 2;
+    uint32 attr_value = 3;
+}
+
+message MatchingBinSearchFilter {
+    uint32 op      = 1;  // 1=Eq 2=Ne
+    uint32 attr_id = 2;
+    bytes  data    = 3;
+}
+
+message SearchRoomRequest {
+    uint32 world_id            = 1;
+    uint64 lobby_id            = 2;
+    uint32 range_filter_start  = 3;  // 1-indexed
+    uint32 range_filter_max    = 4;
+    uint32 flag_filter         = 5;
+    uint32 flag_attr           = 6;
+    repeated MatchingIntSearchFilter int_filters = 7;
+    repeated MatchingBinSearchFilter bin_filters = 8;
+    repeated uint32 attr_ids    = 9;  // attribute ids to include in results
+}
+
+message SearchRoomReply {
+    repeated MatchingRoomDataExternal rooms = 1;
+    uint32 range_start  = 2;
+    uint32 range_total  = 3;
+    uint32 range_result = 4;
+}
+
+message GetRoomDataExternalListRequest {
+    repeated uint64 room_ids = 1;
+    repeated uint32 attr_ids = 2;
+}
+
+message GetRoomDataExternalListReply {
+    repeated MatchingRoomDataExternal rooms = 1;
+}
+
+message GetRoomMemberDataExternalListRequest {
+    uint64 room_id = 1;
+}
+
+message GetRoomMemberDataExternalListReply {
+    repeated MatchingRoomMemberDataExternal members = 1;
+}
+
+message MatchingUserInfo {
+    string npid                            = 1;
+    uint64 account_id                      = 2;
+    uint32 platform                        = 3;
+    repeated MatchingBinAttr user_bin_attrs = 4;
+}
+
+message SetUserInfoRequest {
+    uint32 server_id = 1;
+    repeated MatchingBinAttr user_bin_attrs = 2;
+}
+
+message SetUserInfoReply {}
+
+message GetUserInfoListRequest {
+    repeated string npids    = 1;
+    repeated uint32 attr_ids = 2;
+    int32           option   = 3;
+}
+
+message GetUserInfoListReply {
+    repeated MatchingUserInfo users = 1;
+}
+
+message MatchingWorld {
+    uint32 world_id             = 1;
+    uint32 lobbies_num          = 2;
+    uint32 max_lobby_members    = 3;
+    uint32 lobby_members_num    = 4;
+    uint32 rooms_num            = 5;
+    uint32 room_members_num     = 6;
+}
+
+message GetWorldInfoListRequest {
+    uint32 server_id = 1;
+}
+
+message GetWorldInfoListReply {
+    repeated MatchingWorld worlds = 1;
+}
+
+message RequestSignalingInfosReply {
+    string target_npid      = 1;
+    string target_ip        = 2;
+    uint32 target_port      = 3;
+    uint32 target_member_id = 4;
+}
+
+message LeaveRoomReply            { uint64 room_id = 1; }
+message SetRoomDataInternalReply  { uint64 room_id = 1; }
+message SetRoomMemberDataInternalReply { uint64 room_id = 1; }
+message SetRoomDataExternalReply  { uint64 room_id = 1; }
+message KickoutRoomMemberReply    { uint64 room_id = 1; }
+
+message SendRoomMessageRequest {
+    uint64 room_id = 1;
+    uint32 cast_type = 2;
+    repeated uint32 dst_member_ids = 3;
+    bytes msg = 4;
+    int32 option = 5;
+}
+
+message SendRoomMessageReply { uint64 room_id = 1; }
+
+
+message GetTokenReply {
+    string token = 1;
+    uint64 user_id = 2;
+    string npid = 3;
+}
+
+// Resolve an arbitrary online ID to its account ID
+message LookupOnlineIdRequest {
+    string npid = 1; // online ID to resolve
+}
+
+message LookupOnlineIdReply {
+    uint64 account_id = 1;
+    string npid        = 2; // canonical online ID as registered on the server
+}
+
+// Single-use authorization code issued to the signed-in account for a game's backend, which
+// exchanges it at POST /2.0/oauth/token.
+message GetAuthorizationCodeRequest {
+    string client_id = 1;
+    string scope     = 2;
+}
+
+message GetAuthorizationCodeReply {
+    string code       = 1;
+    uint32 expires_in = 2; // seconds
+}
+
+// Notification payloads
+
+// NotificationType::RoomEvent (10) — every room event maps onto
+// OrbisNpMatching2RoomEventCallback(ctxId, roomId, event, data). The Orbis
+// event id (0x11xx) is carried in `event`; the data shape depends on it:
+// member events fill `member`; room-data-updated fills bin_attrs + flags.
+message NotifyRoomEvent {
+    uint32                   ctx_id      = 1;
+    uint64                   room_id     = 2;
+    uint32                   event       = 3;
+    uint32                   event_cause = 4;
+    int32                    error_code  = 5;
+    MatchingRoomMemberData   member      = 6;
+    repeated MatchingBinAttr bin_attrs   = 7;
+    uint32                   flags       = 8;
+    bool                     has_passwd_mask = 9;
+    uint64                   passwd_slot_mask = 10;
+}
+
+// NotificationType::RoomMessage (11) maps onto
+// OrbisNpMatching2RoomMessageCallback(ctxId, roomId, srcMemberId, event, data).
+message NotifyRoomMessage {
+    uint32 ctx_id = 1;
+    uint64 room_id = 2;
+    uint32 src_member_id = 3;
+    uint32 event = 4;
+    uint32 cast_type = 5;
+    repeated uint32 dst_member_ids = 6;
+    string src_npid = 7;
+    uint64 src_account_id = 8;
+    uint32 src_platform = 9;
+    bytes msg = 10;
+}
+
+// Title User Storage (TUS) 
+
+message TusVariable {
+    string ownerNpId                  = 1;
+    bool   set                        = 2;
+    int64  variable                   = 3;
+    int64  oldVariable                = 4;
+    uint64 lastChangedDate            = 5;
+    string lastChangedAuthorNpId      = 6;
+    int64  ownerAccountId             = 7;
+    int64  lastChangedAuthorAccountId = 8;
+}
+
+message TusDataStatus {
+    string ownerNpId                  = 1;
+    bool   set                        = 2;
+    uint64 lastChangedDate            = 3;
+    string lastChangedAuthorNpId      = 4;
+    uint64 dataSize                   = 5;
+    bytes  info                       = 6;
+    int64  ownerAccountId             = 7;
+    int64  lastChangedAuthorAccountId = 8;
+}
+
+message TusSetMultiSlotVariableRequest {
+    string         ownerNpId = 1;   // empty == self
+    repeated int32 slotIds   = 2;
+    repeated int64 values    = 3;   // parallel to slotIds
+    int64          ownerAccountId = 4;   // A variant target (0 = use ownerNpId / self)
+    string         virtualUser    = 5;   // VUser variant (non-empty -> tus_vuser_variable)
+}
+
+message TusGetMultiSlotVariableRequest {
+    string         ownerNpId      = 1;
+    repeated int32 slotIds        = 2;
+    int64          ownerAccountId = 3;   // != 0 takes precedence over ownerNpId (== owner user_id)
+    string         virtualUser    = 4;   // non-empty -> target a virtual user (overrides owner)
+}
+
+message TusAddAndGetVariableRequest {
+    string ownerNpId            = 1;
+    int32  slotId               = 2;
+    int64  inValue              = 3;   // delta added atomically
+    int64  ownerAccountId       = 4;   // != 0 -> target this account (must be self)
+    string virtualUser          = 5;   // non-empty -> target a virtual user
+    bool   hasAuthorCheck       = 6;   // compare-and-set: only proceed if author matches
+    int64  isLastChangedAuthor  = 7;
+    bool   hasDateCheck         = 8;   // compare-and-set: only proceed if server date <= this
+    uint64 isLastChangedDate    = 9;
+    string isLastChangedAuthorNpId = 10;  // base variant author check (npId); resolved server-side
+}
+
+message TusVariableResponse {
+    repeated TusVariable variables = 1;
+    // Friends queries: total matching friends before startOffset/max are
+    // applied (OrbisNpTusGetFriendsVariableOptParam::hits). 0 elsewhere.
+    uint32 total = 2;
+}
+
+message TusSetDataRequest {
+    string ownerNpId           = 1;
+    int32  slotId              = 2;
+    bytes  data                = 3;
+    bytes  info                = 4;
+    int64  ownerAccountId      = 5;   // A variant target (0 = use ownerNpId / self)
+    string virtualUser         = 6;   // VUser variant (non-empty -> tus_vuser_data)
+    bool   hasAuthorCheck      = 7;   // conflict guard: proceed only if author matches
+    int64  isLastChangedAuthor = 8;
+    bool   hasDateCheck        = 9;   // conflict guard: proceed only if server date <= this
+    uint64 isLastChangedDate   = 10;
+    string isLastChangedAuthorNpId = 11;   // base npid-author path (server resolves to userId)
+}
+
+message TusGetDataRequest {
+    string ownerNpId      = 1;
+    int32  slotId         = 2;
+    int64  ownerAccountId = 3;   // A variant target (0 = use ownerNpId / self)
+    string virtualUser    = 4;   // VUser variant (non-empty -> tus_vuser_data)
+}
+
+message TusGetDataResponse {
+    TusDataStatus status = 1;
+    bytes         data   = 2;
+}
+
+message TusGetMultiSlotDataStatusRequest {
+    string         ownerNpId      = 1;
+    repeated int32 slotIds        = 2;
+    int64          ownerAccountId = 3;   // account-variant target (0 = use ownerNpId / self)
+    string         virtualUser    = 4;   // virtual-user target (non-empty -> tus_vuser_data)
+}
+
+message TusGetMultiUserDataStatusRequest {
+    int32           slotId       = 1;
+    repeated string ownerNpIds   = 2;
+    repeated string virtualUsers = 3;   // VUser variant (non-empty -> tus_vuser_data)
+    repeated int64  ownerAccountIds = 4;   // A/CS account-array target (resolved to user_id)
+}
+
+message TusGetFriendsDataStatusRequest {
+    int32  slotId      = 1;
+    bool   includeSelf = 2;
+    uint32 max         = 3;
+    int32  sortType    = 4;   //1=DESC date, 2=ASC date
+    uint32 startOffset = 5;
+}
+
+message TusGetFriendsVariableRequest {
+    int32  slotId      = 1;
+    bool   includeSelf = 2;
+    uint32 max         = 3;
+    int32  sortType    = 4;   //1=DESC date,2=ASC date,3=DESC value,4=ASC value
+    // Zero-based start position in the friend ranking
+    uint32 startOffset = 5;
+}
+
+message TusDataStatusResponse {
+    repeated TusDataStatus statuses = 1;
+    uint32 total = 2;
+}
+
+message TusTryAndSetVariableRequest {
+    string ownerNpId            = 1;
+    int64  ownerAccountId       = 2;   // != 0 -> target this account (must be self)
+    string virtualUser          = 3;   // non-empty -> target a virtual user
+    int32  slotId               = 4;
+    int32  opeType              = 5;   // 1..6 (EQUAL,NOT_EQUAL,GT,GE,LT,LE)
+    int64  value                = 6;   // value written when condition holds
+    bool   hasCompare           = 7;
+    int64  compareValue         = 8;   // comparand; if !hasCompare, `value` is used
+    bool   hasAuthorCheck       = 9;
+    int64  isLastChangedAuthor  = 10;
+    bool   hasDateCheck         = 11;
+    uint64 isLastChangedDate    = 12;
+    string isLastChangedAuthorNpId = 13;   // base npid-author path (server resolves to userId)
+}
+
+message TusDeleteMultiSlotDataRequest {
+    string         ownerNpId      = 1;
+    repeated int32 slotIds        = 2;
+    int64          ownerAccountId = 3;   // A variant target (0 = use ownerNpId / self)
+    string         virtualUser    = 4;   // VUser variant (non-empty -> vuser tables)
+}
+
+message TusDeleteMultiSlotVariableRequest {
+    string         ownerNpId   = 1;   // empty == self (npid target)
+    string         virtualUser = 2;   // non-empty -> tus_vuser_variable
+    repeated int32 slotIds     = 3;
+    int64          ownerAccountId = 4;   // A variant target (must be self)
+}
+
+message TusGetMultiUserVariableRequest {
+    int32           slotId          = 1;
+    repeated int64  ownerAccountIds = 2;   // one variable per account, in order
+    repeated string virtualUsers    = 3;   // alternative to ownerAccountIds (virtual users)
+    repeated string ownerNpIds      = 4;   // base npid-array path (server resolves each)
+}
+
+// Title Small Storage (TSS)
+
+message TssGetDataRequest {
+    int32  slotId              = 1;
+    bool   hasOffset           = 2;
+    uint64 offset              = 3;
+    bool   hasLastByte         = 4;
+    uint64 lastByte            = 5;
+    bool   hasIfParam          = 6;
+    int32  ifType              = 7;  // 0 = IF_MODIFIED_SINCE, 1 = IF_RANGE
+    uint64 ifLastModified      = 8;  // seconds since epoch
+}
+
+message TssGetDataResponse {
+    
+    int32  statusCodeType = 1; // OrbisNpTssStatusCodeType: 0 = OK, 1 = PARTIAL, 2 = NOT_MODIFIED.
+    uint64 lastModified   = 2; // seconds since epoch, 0 when the file is absent
+    uint64 contentLength  = 3; // size the client should expect for this status
+    bytes  data           = 4; // the (possibly ranged) payload
+}
+
+// Trophies
+
+message TrophyEntry {
+    int32  trophyId  = 1;
+    uint64 timestamp = 2; // seconds since epoch, when the player earned it
+}
+
+// Reports a single unlock as it happens.
+message UnlockTrophyRequest {
+    int32  trophyId  = 1;
+    uint64 timestamp = 2;
+}
+
+// Uploads everything the client holds locally for one game.
+message SyncTrophiesRequest {
+    repeated TrophyEntry trophies = 1;
+}
+
+message SyncTrophiesReply {
+    repeated TrophyEntry trophies = 1;
+}
+
+message SetClientVersionRequest {
+    string version = 1; 
+}
