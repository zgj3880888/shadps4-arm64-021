+        const s64 v1 = Libraries::Font::Internal::RoundFixedMul16x16ToS64(y_scale, seed_high);
+        obj->layout_seed_vec[0] = static_cast<u64>(v0);
+        obj->layout_seed_vec[1] = static_cast<u64>(v1);
