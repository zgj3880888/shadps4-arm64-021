+
+// Protocol enumerations (must match shadnet server protocol.h)
+enum class PacketType : u8 {
+    Request = 0,
+    Reply = 1,
+    Notification = 2,
+    ServerInfo = 3,
+};
+
+enum class CommandType : u16 {
