+    p_alAuxiliaryEffectSlotf =
+        reinterpret_cast<LPALAUXILIARYEFFECTSLOTF>(alGetProcAddress("alAuxiliaryEffectSlotf"));
+
+    ok = p_alGenEffects && p_alDeleteEffects && p_alEffecti && p_alEffectf &&
