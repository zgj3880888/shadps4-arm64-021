+        }
+        const long long sign_adj_max = (y_descender >= 0) ? 0x10000LL : 0LL;
+        long long tmp_max = sign_adj_max +
+                            static_cast<long long>(y_descender) * static_cast<long long>(shear) -
+                            0x8000LL;
+        if (tmp_max < 0) {
