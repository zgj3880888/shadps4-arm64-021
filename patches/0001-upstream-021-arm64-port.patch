+        lib_ctx->RemoveUser();
+        return ORBIS_NP_WEBAPI2_ERROR_HANDLE_NOT_FOUND;
+    }
+
+    lib_ctx->Lock();
+    handle->SetTimeout(timeout);
+    handle->RemoveUser();
+    lib_ctx->Unlock();
+    lib_ctx->RemoveUser();
+    return ORBIS_OK;
+}
