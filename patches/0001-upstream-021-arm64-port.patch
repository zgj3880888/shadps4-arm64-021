+    void SetEndTime() {
+        if (timeout != 0 && end_time == 0) {
+            end_time = Libraries::Kernel::sceKernelGetProcessTime() + timeout;
+        }
+    }
+
+    void ClearEndTime() {
+        end_time = 0;
+    }
+
+    std::string& GetApiGroup() {
+        return api_group;
+    }
+
+    std::string& GetPath() {
+        return path;
