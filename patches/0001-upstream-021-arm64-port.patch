+        i.src0 = std::to_underlying(src0);
+        i.vsrc1 = std::to_underlying(vsrc1);
+        i.vdst = std::to_underlying(vdst);
+        i.op = std::to_underlying(op);
+        i.encoding = 0;
+    }
+
+    u32 Get() {
+        return std::bit_cast<u32>(i);
+    }
+
+private:
+    struct VOP2Internal {
+        u32 src0 : 9;
+        u32 vsrc1 : 8;
+        u32 vdst : 8;
+        u32 op : 6;
+        u32 encoding : 1;
+    } i;
+
