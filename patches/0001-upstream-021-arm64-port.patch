-            ++free_n;
-        } else {
-            ++busy_n;
-        }
-    }
-    if (!StagingVerbose()) {
-        return;
-    }
-    LOG_WARNING(Render_Vulkan,
-                "STAGING_POOL_STATS slots={} free={} busy={} bytes={:#x} grows={} acquired={} "
-                "waits={}",
-                scratch_slots.size(), free_n, busy_n, bytes, scratch_stats_grows,
-                scratch_stats_acquired, scratch_stats_waits);
-}
