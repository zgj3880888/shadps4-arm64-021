+s32 PS4_SYSV_ABI scePlayGoClose(OrbisPlayGoHandle handle) {
+    LOG_INFO(Lib_PlayGo, "called");
+
+    if (handle != PlaygoHandle) {
+        return ORBIS_PLAYGO_ERROR_BAD_HANDLE;
+    }
+    if (!playgo) {
+        return ORBIS_PLAYGO_ERROR_NOT_INITIALIZED;
+    }
+    return ORBIS_OK;
+}
