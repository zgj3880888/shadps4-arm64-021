-        const auto base_dir = GetSysFontBaseDir();
-        if (base_dir.empty()) {
-            return {};
-        }
-        if (def->default_file && *def->default_file) {
-            return ResolveSystemFontPathCandidate(base_dir, def->default_file);
-        }
