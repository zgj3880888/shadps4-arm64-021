-            return -1;
-        } else if (write) {
-            if (append) {
-                // Open exclusively for appending
-                e = file->f.Open(file->m_host_name, Common::FS::FileAccessMode::Append);
-            } else {
-                // Open exclusively for writing
-                e = file->f.Open(file->m_host_name, Common::FS::FileAccessMode::Write);
-            }
-        } else if (rdwr) {
-            // Read and write
-            if (append) {
