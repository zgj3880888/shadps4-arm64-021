-s32 PS4_SYSV_ABI posix_sigemptyset(Sigset* s) {
-    s->bits[0] = 0;
-    s->bits[1] = 0;
-    s->bits[2] = 0;
-    s->bits[3] = 0;
-    return ORBIS_OK;
