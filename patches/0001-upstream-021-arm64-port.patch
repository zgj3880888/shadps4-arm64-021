-    for (const auto& entry : records) {
-        const bool changed = entry.initial != entry.current;
-        if (changed) {
-            fmt::format_to(std::back_inserter(buffer), "{}: {} -> {}\n", entry.name, entry.initial,
-                           entry.current);
-        } else {
-            fmt::format_to(std::back_inserter(buffer), "{}: {}\n", entry.name, entry.initial);
-        }
-    }
-    return fmt::to_string(buffer);
-}
