+    s32 ctx_id = createLibraryContext(lib_http_ctx_id, 3, pool_size, nullptr);
+    if (ctx_id > 0) {
+        LOG_INFO(Lib_NpWebApi2, "created lib_ctx_id = {:#x}", ctx_id);
+    }
+    return ctx_id;
+}
