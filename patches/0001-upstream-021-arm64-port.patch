+struct SdwaVop12 {
+    u32 src0 : 8;
+    u32 dst_sel : 3;
+    u32 dst_u : 2;
+    u32 clamp : 1;
+    u32 omod : 2;
+    u32 src0_sel : 3;
+    u32 src0_sext : 1;
+    u32 src0_neg : 1;
+    u32 src0_abs : 1;
+    u32 : 1;
+    u32 s0 : 1;
+
+    u32 src1_sel : 3;
+    u32 src1_sext : 1;
+    u32 src1_neg : 1;
+    u32 src1_abs : 1;
+    u32 : 1;
+    u32 s1 : 1;
+};
+
+struct SdwaVopc {
+    u32 src0 : 8;
+    u32 sdst : 7;
+    u32 sd : 1;
+    u32 src0_sel : 3;
+    u32 src0_sext : 1;
+    u32 src0_neg : 1;
+    u32 src0_abs : 1;
+    u32 : 1;
+    u32 s0 : 1;
+
+    u32 src1_sel : 3;
+    u32 src1_sext : 1;
+    u32 src1_neg : 1;
+    u32 src1_abs : 1;
+    u32 : 1;
+    u32 s1 : 1;
+};
