+            const float shoulder_y = cy + y_offset - extent * (0.03f * scale);
+            const float base_y = cy + y_offset + extent * (0.21f * scale);
+            const float head_half_w = extent * (0.30f * scale);
+            const float stem_half_w = extent * (0.11f * scale);
