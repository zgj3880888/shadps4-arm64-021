-static bool Is4ByteExtrqOrInsertq(void* code_address) {
-    u8* bytes = (u8*)code_address;
-    if (bytes[0] == 0x66 && bytes[1] == 0x0F && bytes[2] == 0x79) {
-        return true; // extrq
-    } else if (bytes[0] == 0xF2 && bytes[1] == 0x0F && bytes[2] == 0x79) {
-        return true; // insertq
-    } else {
-        return false;
-    }
-}
