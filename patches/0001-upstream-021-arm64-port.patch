-    u16 flags;
-    u8 glyph_form;
-    u8 metrics_form;
-    u16 em_size;
-    u16 baseline;
-    u16 height_px;
-    u16 origin_x;
-    u16 origin_y;
-    float scale_x;
-    float base_scale;
-    const OrbisFontMem* memory;
