-            break;
-        case ImeKbKeyGlyph::ShiftFilled:
-            draw_shift_glyph(true, false);
-            break;
-        case ImeKbKeyGlyph::CapsLockFilled:
-            draw_shift_glyph(true, true);
-            break;
-        case ImeKbKeyGlyph::None:
-        default:
-            break;
-        }
-    };
