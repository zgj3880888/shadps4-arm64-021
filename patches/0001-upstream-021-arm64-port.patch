+static ImU32 ScaleColorAlpha(ImU32 color, float alpha_scale) {
+    ImVec4 c = ImGui::ColorConvertU32ToFloat4(color);
+    c.w = std::clamp(c.w * alpha_scale, 0.0f, 1.0f);
+    return ImGui::ColorConvertFloat4ToU32(c);
