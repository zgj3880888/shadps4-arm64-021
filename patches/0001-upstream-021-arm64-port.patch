-        fd = internal__Fopen(path, calc_mode, s_mode == 0x55);
-        file->_Handle = fd;
-    }
-
-    // Error case
-    if (fd < 0) {
-        // Closes the file, but ensures errno is unchanged.
-        if (flag == 0) {
-            internal__Mtxinit(mtx_ptr, nullptr);
-        } else {
-            file->_Mutex = mtx;
-            internal__Unlockfilelock(file);
-        }
