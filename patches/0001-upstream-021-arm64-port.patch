+    OrbisNetUdpSndOnSuspend back_suspend{};
+    len = sizeof(back_suspend);
+    EXPECT_EQ(sceNetGetsockopt(udp, ORBIS_NET_IPPROTO_UDP, ORBIS_NET_UDP_SND_ON_SUSPEND,
