-        return ParamRecord{std::move(name), DescribeValue(value.before),
-                           DescribeValue(value.after)};
-    } else {
-        const std::string rendered = DescribeValue(value);
-        return ParamRecord{std::move(name), rendered, rendered};
-    }
-}
