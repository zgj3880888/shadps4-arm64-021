+    if (*mutex) {
+        (*mutex)->name = name;
+    }
+    return 0;
+}
+
+s32 PS4_SYSV_ABI scePthreadMutexInit(PthreadMutexT* mutex, const PthreadMutexAttrT* mutex_attr,
+                                     const char* name) {
+    return MutexInit(mutex, mutex_attr ? *mutex_attr : nullptr, name);
+}
