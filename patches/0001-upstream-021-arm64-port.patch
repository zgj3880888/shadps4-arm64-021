+    const s64 sign_adj = ((~value) >> 63) * -0x10000LL;
+    const s64 base = sign_adj + prod;
+    s64 tmp = base - 0x8000LL;
+    if (tmp < 0) {
+        tmp = base + 0x7FFFLL;
+    }
+    return static_cast<s32>(static_cast<u64>(tmp) >> 16);
