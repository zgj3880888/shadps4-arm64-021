+struct OrbisKeyboardData {
+    s64 timestamp; // microseconds
+    u8 padding[8];
+    u32 unk1; // always 1
+    u32 nkeys;
+    u32 locks; // num lock, caps lock, scroll lock
+    u32 mods;  // ctrl, shift, alt, meta
+    u16 keycodes[32];
+};
+
+struct OrbisKeyboardKey2Char {
+    s32 ok;
+    s32 ok2; // wtf it is
+    s32 keycode;
+    char unk[8]; // zeros
+};
