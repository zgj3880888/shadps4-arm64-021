+static std::unordered_map<s32, EqueueInternal*> kqueues;
+static constexpr auto HrTimerSpinlockThresholdNs = 1200000u;
+
+EqueueInternal* GetEqueue(OrbisKernelEqueue eq) {
+    if (!kqueues.contains(eq)) {
+        return nullptr;
+    }
+    return kqueues[eq];
