+inline int FloorIntCompat(float v) {
+    int i = static_cast<int>(std::trunc(v));
+    if (static_cast<float>(i) > v) {
+        --i;
+    }
+    return i;
+}
+
+inline int CeilIntCompat(float v) {
+    int i = static_cast<int>(std::trunc(v));
+    if (static_cast<float>(i) < v) {
+        ++i;
+    }
+    return i;
+}
