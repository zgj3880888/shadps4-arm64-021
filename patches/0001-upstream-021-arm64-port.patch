+                *out_micro_tiled_mips |= 1u << mip;
+            }
+        }
+        if (is_block) {
+            mip_info.pitch = std::max<u16>(mip_info.pitch * 4, 32u);
+            mip_info.height = std::max<u16>(mip_info.height * 4, 32u);
+        }
