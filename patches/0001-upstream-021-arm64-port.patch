+
+bool ConnectionKey::operator<(const ConnectionKey& other) const {
+    if (!(peer == other.peer)) {
+        return peer < other.peer;
+    }
+    return std::tie(peer_vport, local_vport) < std::tie(other.peer_vport, other.local_vport);
+}
+
+void ReadinessFlag::Set(bool ready) {
+    if (ready == ready_) {
+        return;
+    }
+    ready_ = ready;
+    if (ready) {
+        wake_.Signal();
+    } else {
+        wake_.Drain();
+    }
+}
