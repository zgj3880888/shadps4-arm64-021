-    SOCKET listener = INVALID_SOCKET;
-    SOCKET sock1 = INVALID_SOCKET;
-    SOCKET sock2 = INVALID_SOCKET;
-    sockaddr_in addr{};
-    int addrlen = sizeof(addr);
-
-    listener = socket(AF_INET, SOCK_STREAM, 0);
