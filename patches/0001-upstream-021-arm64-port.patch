-s32 PthreadMutex::SelfTryLock() {
-    switch (Type()) {
-    case PthreadMutexType::ErrorCheck:
-    case PthreadMutexType::Normal:
-    case PthreadMutexType::AdaptiveNp:
-        return POSIX_EBUSY;
-    case PthreadMutexType::Recursive: {
-        /* Increment the lock count: */
-        if (m_count + 1 > 0) {
-            m_count++;
-            return 0;
-        }
-        return POSIX_EAGAIN;
-    }
-    default:
-        return POSIX_EINVAL;
-    }
-}
