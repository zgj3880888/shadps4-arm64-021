+namespace Core {
+
+using AccessViolationHandler = bool (*)(void* context, void* fault_address);
+using IllegalInstructionHandler = bool (*)(void* context);
+
+#ifndef _WIN32
+void SignalHandler(int sig, siginfo_t* info, void* raw_context);
