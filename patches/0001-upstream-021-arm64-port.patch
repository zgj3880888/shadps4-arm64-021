-    }
-    if (code_unit >= 'A' && code_unit <= 'Z') {
-        return static_cast<u16>(0x0004 + (code_unit - 'A')); // SCE_IME_KEYCODE_A...
-    }
-    if (code_unit >= '1' && code_unit <= '9') {
