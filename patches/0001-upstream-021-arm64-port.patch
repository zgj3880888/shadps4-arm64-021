-
-    auto trophyconf = doc.child("trophyconf");
-    for (pugi::xml_node& node : trophyconf.children()) {
-        if (std::string_view(node.name()) != "trophy") {
-            continue;
-        }
-        int id = node.attribute("id").as_int(ORBIS_NP_TROPHY_INVALID_TROPHY_ID);
