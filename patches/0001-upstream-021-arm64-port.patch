+    if (s->p2p_stream) {
+        const Error e = s->p2p_stream->ConnectResult();
+        info->pending_error =
+            e == Error::InProgress || e == Error::NotConn ? Error::Ok : e; // never cleared
+    } else if (s->p2p_dgram) {
+        info->pending_error = Error::Ok;
+    } else {
+        info->pending_error = Host::PendingSocketError(s->native);
+    }
+    return NetResult::Ok();
