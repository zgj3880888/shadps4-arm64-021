-            // Mouse left button dragging (=> update selection)
-            else if (ImGui::IsMouseDragging(0) && ImGui::IsMouseDown(0)) {
-                io.WantCaptureMouse = true;
-                mState.mCursorPosition = mInteractiveEnd =
-                    ScreenPosToCoordinates(ImGui::GetMousePos());
