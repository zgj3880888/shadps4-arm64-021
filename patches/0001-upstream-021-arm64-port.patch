+        i.ssrc1 = std::to_underlying(ssrc1);
+        i.sdst = std::to_underlying(sdst);
+        i.op = std::to_underlying(op);
+        i.encoding = 0b10;
+    }
+
+    u32 Get() {
+        return std::bit_cast<u32>(i);
+    }
+
+private:
+    struct SOP2Internal {
+        u32 ssrc0 : 8;
+        u32 ssrc1 : 8;
+        u32 sdst : 7;
+        u32 op : 7;
+        u32 encoding : 2;
