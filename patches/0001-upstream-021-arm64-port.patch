-                figure.id = u32(to_write_buf[0]) | (u32(to_write_buf[1]) << 8) |
-                            (u32(to_write_buf[2]) << 16) | (u32(to_write_buf[3]) << 24);
-            }
-            std::memcpy(figure.data.data() + (page * 4), to_write_buf, 4);
