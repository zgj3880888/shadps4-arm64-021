+            const std::array<ImVec2, 7> shape{
+                ImVec2{cx, tip_y},
+                ImVec2{cx - head_half_w, shoulder_y},
+                ImVec2{cx - stem_half_w, shoulder_y},
+                ImVec2{cx - stem_half_w, base_y},
+                ImVec2{cx + stem_half_w, base_y},
+                ImVec2{cx + stem_half_w, shoulder_y},
+                ImVec2{cx + head_half_w, shoulder_y},
+            };
+
+            if (filled) {
+                draw->AddConvexPolyFilled(shape.data(), static_cast<int>(shape.size()), color);
