+    OrbisNpCalloutEntry** prev_next = &callout_ctx->head;
+    for (auto* cur = callout_ctx->head; cur != nullptr; cur = cur->next) {
+        if (cur->deadline_usec >= entry->deadline_usec) {
+            break;
+        }
+        prev_next = &cur->next;
