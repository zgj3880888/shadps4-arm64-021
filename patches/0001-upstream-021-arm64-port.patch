-    }
-    frame = SDL_AcquireCameraFrame(sdl_camera, &timestampNS);
-
-    if (!frame) {
-        return ORBIS_CAMERA_ERROR_BUSY;
-    }
-
-    switch (output_config0.format.formatLevel0) {
-    case ORBIS_CAMERA_FORMAT_YUV422:
