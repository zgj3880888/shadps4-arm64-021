+u32 IpStringToAddr(std::string_view ip) {
+    u32 a, b, c, d;
+    if (std::sscanf(std::string(ip).c_str(), "%u.%u.%u.%u", &a, &b, &c, &d) != 4) {
+        return 0;
+    }
+    return a | (b << 8) | (c << 16) | (d << 24);
+}
