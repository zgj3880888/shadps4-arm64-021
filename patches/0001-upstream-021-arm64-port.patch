+    }
+    for (u64 i = 0; i < request.roomBinAttrExternalNum; ++i) {
+        LogBinAttr("  externalBin", i, request.roomBinAttrExternal[i]);
+        AppendBinAttr(req.add_ext_bin_attrs(), request.roomBinAttrExternal[i]);
