-u8 DimensionsToypad::GenerateChecksum(const std::array<u8, 32>& data, u32 num_of_bytes) {
-    int checksum = 0;
-    ASSERT(num_of_bytes <= data.size());
-    for (u8 i = 0; i < num_of_bytes; i++) {
-        checksum += data[i];
-    }
-    return (checksum & 0xFF);
-}
