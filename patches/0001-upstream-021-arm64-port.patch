+                      option->size, sizeof(OrbisNpTusGetFriendsDataStatusOptParam));
+            return ORBIS_NP_COMMUNITY_ERROR_INVALID_ALIGNMENT;
+        }
+        // startSerialRank is a 1-based rank
+        if (option->startSerialRank) {
