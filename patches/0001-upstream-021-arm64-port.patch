-    auto* draw = ImGui::GetWindowDrawList();
-    if (!draw || layout.cols <= 0 || layout.rows <= 0 || layout.size.x <= 0.0f ||
-        layout.size.y <= 0.0f) {
-        return;
-    }
-
-    const ImeKbLayoutModel* model = params.layout_model;
-    if (!model) {
-        model = &GetImeKeyboardLayout(params.selection);
