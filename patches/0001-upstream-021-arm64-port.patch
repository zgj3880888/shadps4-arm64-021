+
+    got = 99;
+    EXPECT_EQ(sceHttpGetAutoRedirect(req, &got), ORBIS_OK);
+    EXPECT_EQ(got, 0) << "request should keep snapshot, not follow connection";
+
+    // Connection's current value is 1.
