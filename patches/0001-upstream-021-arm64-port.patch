+    EXPECT_EQ(sceNetConnect(s, Guest(&to), sizeof(to)), ORBIS_NET_ERROR_EWOULDBLOCK);
+    EXPECT_GE(Millis(start), 190.0);
+    EXPECT_LT(Millis(start), 2000.0);
+    sceNetSocketClose(s);
+    sceNetSocketClose(sink);
