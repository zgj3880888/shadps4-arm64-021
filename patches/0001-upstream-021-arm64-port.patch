-    }
-
-    if (flag == 0) {
-        char mtx_name[0x20];
-        std::snprintf(mtx_name, 0x20, "FileFD:0x%08X", fd);
-        internal__Mtxinit(mtx_ptr, mtx_name);
-    } else {
-        file->_Mutex = mtx;
-    }
-    return file;
-}
