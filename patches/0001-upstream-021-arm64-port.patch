+    NpAuthRequest* request = nullptr;
+    if (const s32 error = FindRequest(req_id, &request); error != ORBIS_OK) {
+        return error;
+    }
+    if (request->ctx) {
+        request->ctx->SetResult(ORBIS_NP_AUTH_ERROR_ABORTED);
+    } else {
+        request->aborted = true;
+    }
+    return ORBIS_OK;
