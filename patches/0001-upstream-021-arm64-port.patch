-    days = pTick->tick / 86400000000;
-    msec = pTick->tick % 86400000000;
-
-    days += 307;
-
-    j = (days << 2) - 1;
-    ly = j / 146097;
-
-    j -= (146097 * ly);
-    ld = j >> 2;
-
-    j = ((ld << 2) + 3) / 1461;
-    ld = (((ld << 2) + 7) - 1461 * j) >> 2;
-
-    lm = (5 * ld - 3) / 153;
-    ld = (5 * ld + 2 - 153 * lm) / 5;
-    ly = 100 * ly + j;
-
-    if (lm < 10) {
-        lm += 3;
-    } else {
-        lm -= 9;
-        ly++;
-    }
-
-    pTime->year = ly;
-    pTime->month = lm;
-    pTime->day = ld;
-
-    pTime->hour = msec / 3600000000;
-    msec %= 3600000000;
-    pTime->minute = msec / 60000000;
-    msec %= 60000000;
-    pTime->second = msec / 1000000;
-    msec %= 1000000;
-    pTime->microsecond = msec;
