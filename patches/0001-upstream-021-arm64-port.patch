-        return static_cast<s32>(value.U32());
-    } else if constexpr (std::is_same_v<T, f32>) {
-        return value.F32();
-    } else if constexpr (std::is_same_v<T, u64>) {
-        return value.U64();
-    } else if constexpr (std::is_same_v<T, s64>) {
-        return static_cast<s64>(value.U64());
-    }
-}
