-
-    // clang-format off
-    constexpr static std::array ps0_code alignas(256) = {
-        0xbeeb03ffu, 0x00000003u, // s_mov_b32     vcc_hi, $0x00000003
-        0x7e000280u,              // v_mov_b32     v0, 0
-        0x5e000100u,              // v_cvt_pkrtz_f16_f32 v0, v0, v0
-        0xbf800000u,              // s_nop
