+namespace ImGui::ShadNetNotify {
+
+// Kind drives the colored tag shown on the toast and in the history list.
+enum class Kind {
+    FriendRequest,
+    FriendNew,
+    FriendLost,
+    Online,
+    Info,
+    Warning, // the server refused something (e.g. matchmaking full)
