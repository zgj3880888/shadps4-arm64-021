-            m_instruction.dst[0].field = sdwa.sd ? OperandField::ScalarGPR : OperandField::VccLo;
-            m_instruction.dst[0].code = sdwa.sdst;
-
-        } else if (encoding == InstEncoding::VOP1 || encoding == InstEncoding::VOP2) {
