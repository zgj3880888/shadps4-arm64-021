+s32 PS4_SYSV_ABI sceVideoOutGetFlipStatus(s32 handle, FlipStatus* status) {
+    if (!status) {
+        LOG_ERROR(Lib_VideoOut, "Flip status is null");
+        return ORBIS_VIDEO_OUT_ERROR_INVALID_ADDRESS;
