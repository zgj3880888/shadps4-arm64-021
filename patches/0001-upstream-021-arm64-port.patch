+constexpr s32 POSIX_SIG_BLOCK = 1;   /* block specified signal set */
+constexpr s32 POSIX_SIG_UNBLOCK = 2; /* unblock specified signal set */
+constexpr s32 POSIX_SIG_SETMASK = 3; /* set specified signal set */
