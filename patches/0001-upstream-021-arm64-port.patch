+        break;
+    case ORBIS_NP_MATCHING2_ROOM_BIN_ATTR_EXTERNAL_1_ID:
+    case ORBIS_NP_MATCHING2_ROOM_BIN_ATTR_EXTERNAL_2_ID:
+        AppendBinAttr(req.add_external_bin_attrs(), src);
+        LOG_INFO(Lib_NpMatching2,
