-            m_instruction.src[1].field =
-                sdwa.s1 == 0 ? OperandField::VectorGPR : getOperandField(m_instruction.src[1].code);
-            m_instruction.src[1].sdwa_sel = SdwaSelector(sdwa.src1_sel);
