+    static int Errno() {
+        return *Libraries::Kernel::__Error();
+    }
+
+    static OrbisNetSockaddrIn Loopback() {
+        OrbisNetSockaddrIn in{};
+        in.sin_len = sizeof(in);
+        in.sin_family = ORBIS_NET_AF_INET;
+        in.sin_addr = sceNetHtonl(0x7F000001);
