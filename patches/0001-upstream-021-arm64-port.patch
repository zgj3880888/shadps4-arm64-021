+    {
+      formatter.x86_64-linux = pkgsLinux.nixpkgs-fmt;
+      devShells.x86_64-linux.default =
+        let
+          shell =
+            { self
+            , lib
+            , mkShell
+            , clangStdenv
+            , clang-tools
+            , cmake
+            , pkg-config
+            , vulkan-loader
+            , renderdoc
+            , gef
+            , strace
+            , perf
