+ * - IT_SET_CONFIG_REG
+ * - IT_SET_CONTEXT_REG
+ * - IT_SET_CONTEXT_REG_INDIRECT
+ * - IT_SET_SH_REG
+ * - IT_SET_SH_REG_INDEX
+ * - IT_SET_UCONFIG_REG
