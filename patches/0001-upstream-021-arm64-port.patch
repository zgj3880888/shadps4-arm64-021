+    [[nodiscard]] u32 Size() const {
+        return header.count << 2u;
+    }
+
+    template <PM4ShaderType type = PM4ShaderType::ShaderGraphics, typename... Args>
+    static constexpr u32* SetContextReg(u32* cmdbuf, Args... data) {
