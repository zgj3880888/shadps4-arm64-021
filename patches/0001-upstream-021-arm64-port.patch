+#ifdef _WIN32
+    const auto handle = reinterpret_cast<HANDLE>(_get_osfhandle(_fileno(file)));
+    if (handle == INVALID_HANDLE_VALUE) {
+        return std::nullopt;
+    }
+    return GetFileInfoFromHandle(handle);
+#else
+    struct stat stat{};
+    if (::fstat(fileno(file), &stat) != 0) {
+        return std::nullopt;
+    }
+    return GetFileInfoFromStat(stat);
+#endif
+}
