+    u64 uVar7 = uVar3 & 0x3fd1fffffULL;
+    if (sdk > 0x24fffff) {
+        uVar7 = uVar3;
+    }
+    u64 uVar8 = uVar7 & 0x2031fffffULL;
+    if (sdk > 0x4ffffff) {
+        uVar8 = uVar7;
+    }
+    uVar7 = uVar8 & 0x1ff1fffffULL;
+    if (sdk > 0xfffffff) {
+        uVar7 = uVar8;
+    }
