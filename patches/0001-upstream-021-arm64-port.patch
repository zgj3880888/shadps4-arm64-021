-    SynchronizeBuffer(buffer, device_addr, size, is_written, is_texel_buffer);
-    if (is_written) {
-        gpu_modified_ranges.Add(device_addr, size);
-    }
-    return {&buffer, buffer.Offset(device_addr)};
-}
