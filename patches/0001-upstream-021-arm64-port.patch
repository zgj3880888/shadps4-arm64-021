-    if (prod0->GetOpcode() != IR::Opcode::IEqual32 ||
-        !(prod0->Arg(1).IsImmediate() && prod0->Arg(1).U32() == 0u)) {
-        return not_found;
-    }
-
-    // The bitfield extract might be hidden by phi sometimes
-    auto* prod0_arg0 = prod0->Arg(0).InstRecursive();
