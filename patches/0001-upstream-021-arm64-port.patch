+#define THR_MUTEX_INITIALIZER ((PthreadMutex*)NULL)
+#define THR_ADAPTIVE_MUTEX_INITIALIZER ((PthreadMutex*)1)
+#define THR_MUTEX_DESTROYED ((PthreadMutex*)2)
