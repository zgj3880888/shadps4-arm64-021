-    }
-    if (EmulatorSettings.GetCameraId() == -1) {
-        return ORBIS_CAMERA_ERROR_NOT_CONNECTED;
-    }
-    Uint64 timestampNS = 0;
-    static SDL_Surface* frame = nullptr;
-    if (frame) { // release previous frame, if it exists
