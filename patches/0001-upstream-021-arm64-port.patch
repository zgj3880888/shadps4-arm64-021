-    av_frame_get_buffer(nv12_frame.get(), 0);
-
-    if (m_sws_context == nullptr) {
-        m_sws_context =
-            SWSContextPtr(sws_getContext(frame.width, frame.height, AVPixelFormat(frame.format),
