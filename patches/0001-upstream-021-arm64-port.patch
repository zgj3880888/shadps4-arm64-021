-        if (candidate == st.ext_ft_face) {
-            return st.system_font_scale_factor;
-        }
-        for (const auto& fb : st.system_fallback_faces) {
-            if (fb.ready && fb.ft_face == candidate) {
-                return fb.scale_factor;
-            }
-        }
-        return st.system_font_scale_factor;
-    };
-
