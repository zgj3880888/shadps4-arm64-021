+static s32 PS4_SYSV_ABI sceMusicPlayerServiceSetTrackList(s32 player_id, const void* tracks,
+                                                          u32 count) {
+    return SetTrackListInternal(player_id, tracks, count, 0, 0xc2f);
+}
