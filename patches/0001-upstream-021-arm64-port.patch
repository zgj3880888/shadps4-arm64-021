-            if (w_u <= static_cast<u32>(-x0)) {
-                x1 = 0;
-            }
-            x0_out = 0;
-        } else {
-            x1 = surface_w;
-            x0_out = surface_w;
-            if (static_cast<u32>(x0) <= surface_w) {
-                if (surface_w < w_u) {
-                    w_u = surface_w;
-                }
-                x1 = w_u + static_cast<u32>(x0);
