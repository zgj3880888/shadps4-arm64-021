-    mLines.emplace_back(Line());
-    for (auto chr : aText) {
-        if (chr == '\r') {
-            // ignore the carriage return character
-        } else if (chr == '\n')
-            mLines.emplace_back(Line());
-        else {
-            mLines.back().emplace_back(Glyph(chr, PaletteIndex::Default));
-        }
-    }
