-        return ORBIS_HTTP_ERROR_INVALID_ID;
-    }
-    if (mode == ORBIS_HTTP_HEADER_OVERWRITE) {
-        headers->erase(
-            std::remove_if(headers->begin(), headers->end(),
-                           [&](const auto& kv) { return HeaderNameMatches(kv.first, name); }),
-            headers->end());
-    }
-    headers->emplace_back(name, value);
