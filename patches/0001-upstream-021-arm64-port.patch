+            , zarchive
+            , zlib
+            , zydis
+            , pugixml
+              # Parameters:
+            , dontStrip
+            , releaseMode
+            , enableDiscordRpc ? false
+            , enableSystemLibraries ? false
+            , enableTests ? false
+            ,
+            }:
+            let
+              getFfmpegZip = commit: hash: {
+                inherit commit;
+                path = fetchurl {
