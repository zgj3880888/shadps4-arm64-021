-    struct RenderedKey {
-        const ImeKbKeySpec* key = nullptr;
-        int row = 0;
-        int col = 0;
-        u8 col_span = 1;
-        u8 row_span = 1;
-        ImVec2 pos{};
-        ImVec2 size{};
-        ImVec2 center{};
-        ImU32 bg = 0;
-        const char* label = nullptr;
