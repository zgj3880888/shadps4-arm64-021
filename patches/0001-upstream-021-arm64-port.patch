+        break;
+    case Opcode::IMAGE_SAMPLE_CD:
+        flags.set(MimgModifier::CoarseDerivative);
+        break;
+    case Opcode::IMAGE_SAMPLE_CD_CL:
+        flags.set(MimgModifier::CoarseDerivative, MimgModifier::LodClamp);
