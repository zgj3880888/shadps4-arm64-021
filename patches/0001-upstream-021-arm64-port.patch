-void NormalizeAndAppendPath(char* dest, char* src) {
-    char* lastSlash;
-    u64 length;
-
-    lastSlash = strrchr(dest, '/');
-    if (lastSlash == NULL) {
-        length = strlen(dest);
-        dest[length] = '/';
-        dest[length + 1] = '\0';
-    } else {
-        lastSlash[1] = '\0';
-    }
-    if (*src == '/') {
-        dest[0] = '\0';
-    }
-    length = strnlen(dest, 0x3fff);
-    strncat(dest, src, 0x3fff - length);
-    return;
-}
