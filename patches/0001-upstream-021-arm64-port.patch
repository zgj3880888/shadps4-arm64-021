-static AudioFormatInfo GetFormatInfo(const OrbisAudioOutParamFormat format) {
-    static constexpr std::array<AudioFormatInfo, 8> format_infos = {{
-        // S16Mono
-        {false, 2, 1, {0}, false},
-        // S16Stereo
-        {false, 2, 2, {0, 1}, false},
-        // S16_8CH
-        {false, 2, 8, {0, 1, 2, 3, 4, 5, 6, 7}, false},
-        // FloatMono
-        {true, 4, 1, {0}, false},
-        // FloatStereo
