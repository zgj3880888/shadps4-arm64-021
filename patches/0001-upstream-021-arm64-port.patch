-
-    static constexpr u32 kTagPs3 = 0x00337370;  // "ps3"
-    static constexpr u32 kTagVita = 0x32707370; // "psp2(VITA)"
-    static constexpr u32 kTagPs4 = 0x00347370;  // "ps4"
