+
+    void Lock() {
+        lock.lock();
+    }
+
+    void Unlock() {
+        lock.unlock();
+    }
+
+    void AddUser() {
+        std::scoped_lock lk{lock};
+        user_count++;
+    }
+
+    void RemoveUser() {
+        std::scoped_lock lk{lock};
+        user_count--;
