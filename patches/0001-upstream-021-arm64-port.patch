+void IOFile::Unlink() {
+    if (!IsOpen()) {
+        return;
+    }
+
+    // Mark the file for deletion
+    // TODO: Also remove the file path?
+#ifdef _WIN64
+    FILE_DISPOSITION_INFORMATION disposition;
+    IO_STATUS_BLOCK iosb;
