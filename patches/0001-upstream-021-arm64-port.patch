+// Connection snapshots template settings at creation.
+TEST_F(HttpLifecycle, ConnectionSnapshotsTemplateAutoRedirectAtCreation) {
+    int ctx = sceHttpInit(0, 0, 4096);
+    int tmpl = sceHttpCreateTemplate(ctx, "UA", 1, 0);
