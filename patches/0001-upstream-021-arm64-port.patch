-        auto& line = mLines[aCoordinates.mLine];
-        auto cindex = GetCharacterIndex(aCoordinates);
-
-        if (cindex + 1 < (int)line.size()) {
-            auto delta = UTF8CharLength(line[cindex].mChar);
-            cindex = std::min(cindex + delta, (int)line.size() - 1);
-        } else {
