+    }
+
+    template <PM4ShaderType type = PM4ShaderType::ShaderGraphics, typename... Args>
+    static constexpr u32* SetShReg(u32* cmdbuf, Args... data) {
+        return WritePacket<PM4ItOpcode::SetShReg>(cmdbuf, type, data...);
+    }
