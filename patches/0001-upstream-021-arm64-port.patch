+    const bool connected = s->p2p_stream ? s->p2p_stream->GetPeer(peer, peer_vport)
+                                         : s->p2p_dgram->GetPeer(peer, peer_vport);
+    return connected ? NetResult::Ok() : NetResult::Fail(Error::NotConn);
+}
