-extern "C" void PS4_SYSV_ABI _sceFiberForceQuit(u64 ret) {
-    OrbisFiberContext* g_ctx = GetFiberContext();
-    g_ctx->return_val = ret;
-    _sceFiberLongJmp(g_ctx);
-}
