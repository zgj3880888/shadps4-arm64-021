+TEST_F(NetLib, StoredOptionsReadBack) {
+    const OrbisNetId s = sceNetSocket("opts", ORBIS_NET_AF_INET, ORBIS_NET_SOCK_STREAM, 0);
+    const struct {
+        s32 level;
