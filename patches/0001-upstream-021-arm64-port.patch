+#define CHECK_AND_INIT_MUTEX                                                                       \
+    if (PthreadMutex* m = *mutex; m <= THR_MUTEX_DESTROYED) [[unlikely]] {                         \
+        if (s32 ret = InitStatic(g_curthread, mutex); ret) {                                       \
+            return ret;                                                                            \
+        }                                                                                          \
+        m = *mutex;                                                                                \
+    }
