-s32 GetCharGlyphMetrics(OrbisFontHandle fontHandle, u32 code, OrbisFontGlyphMetrics* metrics,
-                        bool use_cached_style) {
-    auto clear_metrics = [&] {
-        if (metrics) {
-            *metrics = {};
-        }
