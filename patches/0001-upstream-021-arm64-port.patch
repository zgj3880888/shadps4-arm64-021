+s32 PS4_SYSV_ABI posix_dup2(s32 old_fd, s32 new_fd) {
+    LOG_TRACE(Kernel_Fs, "old_fd = {}, new_fd = {}", old_fd, new_fd);
+    auto* h = Common::Singleton<Core::FileSys::HandleTable>::Instance();
+    if (h->GetFile(old_fd) == nullptr) {
