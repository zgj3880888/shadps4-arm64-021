-            }
-
-            // If the page must be (un)protected
-            if ((new_count == 0 && !track) || (new_count == 1 && track)) {
-                if (range_bytes == 0) {
-                    // Start a new potential range
-                    range_begin = base_page + page;
-                    potential_range_bytes = PM_PAGE_SIZE;
