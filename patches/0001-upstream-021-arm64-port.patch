+Runner::~Runner() {
+    if (device_) {
+        device_.waitIdle();
+        if (fence_)
+            device_.destroyFence(fence_);
+        if (pipeline_layout_)
+            device_.destroyPipelineLayout(pipeline_layout_);
+        if (descriptor_set_layout_)
+            device_.destroyDescriptorSetLayout(descriptor_set_layout_);
+        if (command_pool_)
+            device_.destroyCommandPool(command_pool_);
+        device_.destroy();
+    }
+    if (instance_)
+        instance_.destroy();
+}
