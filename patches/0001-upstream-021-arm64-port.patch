+Error PS4_SYSV_ABI sceSaveDataGetEventResult(const OrbisSaveDataEventParam* param,
+                                             OrbisSaveDataEvent* event) {
+    if (!g_initialized) {
+        LOG_INFO(Lib_SaveData, "called without initialize");
