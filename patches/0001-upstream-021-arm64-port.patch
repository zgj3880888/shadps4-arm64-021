-    auto& result = *mLines.insert(mLines.begin() + aIndex, Line());
-
-    ErrorMarkers etmp;
-    for (auto& i : mErrorMarkers)
-        etmp.insert(ErrorMarkers::value_type(i.first >= aIndex ? i.first + 1 : i.first, i.second));
-    mErrorMarkers = std::move(etmp);
