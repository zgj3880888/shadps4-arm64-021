-template <typename T>
-[[nodiscard]] T Arg(const IR::Value& value) {
-    if constexpr (std::is_same_v<T, bool>) {
-        return value.U1();
-    } else if constexpr (std::is_same_v<T, u32>) {
-        return value.U32();
