+    const u32 thickness = AmdGpu::GetMicroTileThickness(array_mode);
+    const bool macro = AmdGpu::IsMacroTiled(array_mode);
+    *out_size = 0;
+    *out_micro_tiled_mips = 0;
+    for (s32 mip = 0; mip < levels; ++mip) {
+        u32 mip_w = pitch >> mip;
+        u32 mip_h = height >> mip;
+        if (is_block) {
+            mip_w = (mip_w + 3) / 4;
+            mip_h = (mip_h + 3) / 4;
+        }
