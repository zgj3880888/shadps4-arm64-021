-int TextEditor::GetCharacterColumn(int aLine, int aIndex) const {
-    if (aLine >= mLines.size())
-        return 0;
-    auto& line = mLines[aLine];
-    int col = 0;
-    int i = 0;
-    while (i < aIndex && i < (int)line.size()) {
-        auto c = line[i].mChar;
-        i += UTF8CharLength(c);
-        if (c == '\t')
-            col = (col / mTabSize) * mTabSize + mTabSize;
-        else
-            col++;
-    }
-    return col;
-}
