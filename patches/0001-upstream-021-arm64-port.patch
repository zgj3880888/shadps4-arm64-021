+    start = std::chrono::steady_clock::now();
+    EXPECT_EQ(sceNetRecv(s, buf, sizeof(buf), 0), ORBIS_NET_ERROR_EINTR);
+    EXPECT_LT(Millis(start), 2000.0);
+    aborter.join();
+    sceNetSocketClose(s);
