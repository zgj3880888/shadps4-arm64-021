+    // Drain via blocking GetStatusCode (default blocking mode).
+    int sc;
+    sceHttpGetStatusCode(req, &sc);
+    // Flip to nonblock - worker is done, nonblock check no longer fires.
+    sceHttpSetNonblock(req, 1);
